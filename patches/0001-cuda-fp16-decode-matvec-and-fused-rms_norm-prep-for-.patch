+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t k = 2048;
+        ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n_tokens);
+        ggml_set_name(x, "x");
+        ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k);
+        ggml_set_name(w, "w");
+        ggml_tensor * a = use_id ? ggml_new_tensor_3d(ctx, type_a, k, m, 16) : ggml_new_tensor_2d(ctx, type_a, k, m);
+        ggml_set_name(a, "a");
+        ggml_tensor * ids = nullptr;
+        if (use_id) {
+            ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 16, n_tokens);
+            ggml_set_name(ids, "ids");
+            ids = ggml_view_2d(ctx, ids, 4, n_tokens, ids->nb[1], 0);
+        }
