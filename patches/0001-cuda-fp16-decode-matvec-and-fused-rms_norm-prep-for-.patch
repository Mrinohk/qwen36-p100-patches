+struct test_p60_norm_matmul : public test_case {
+    const ggml_type type_a;
+    const int64_t m;
+    const int64_t n_tokens;
+    const bool use_id;
+    const bool skip;
+
+    std::string vars() override {
+        return VARS_TO_STR5(type_a, m, n_tokens, use_id, skip);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "P60_NORM_MATMUL";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    test_p60_norm_matmul(ggml_type type_a = GGML_TYPE_Q4_K, int64_t m = 512, int64_t n_tokens = 1, bool use_id = false, bool skip = false)
