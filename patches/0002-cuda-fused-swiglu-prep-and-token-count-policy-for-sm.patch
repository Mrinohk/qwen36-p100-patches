+    int64_t row_stride = -1; // rows evenly spaced, else not cacheable
+    if (!ids) {
+        row_stride = s11;
+    } else if (ne11 == 1) {
+        row_stride = s12;
+    } else if (s12 == ne11*s11) {
+        row_stride = s11;
+    }
+    const bool cacheable = row_stride >= 0 && p60_cache_usable(ctx, stream);
+    ggml_cuda_pool_alloc<char> prep_scoped(ctx.pool());
+    char * prep = cacheable ? p60_cache_find(ctx, base, src1->data, stream, nrows_y, row_stride, ne00) : nullptr;
+    if (prep == nullptr) {
+        prep = cacheable ? p60_cache_claim(ctx, base, src1->data, stream, nrows_y, row_stride, ne00, prep_bytes)
+                         : prep_scoped.alloc(prep_bytes);
         mmvq_p60_prep_x<<<nrows_y, dim3(32, std::min(lpr, 32)), 0, stream>>>(
             (const float *) src1->data, (half2 *) prep, is_q8_0 && !cacheable ? nullptr : (float2 *) (prep + xp_bytes),
             (float *) (prep + xp_bytes + ss_bytes), lpr, ne11, s11, s12);
@@ -574,29 +604,22 @@ bool ggml_cuda_p60_rms_norm_mul(ggml_backend_cuda_context & ctx, const ggml_tens
     const int64_t nrows = src->ne[1];
     if (src->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || mul_tensor->type != GGML_TYPE_F32 ||
             src->ne[0] != 2048 || src->ne[2] != 1 || src->ne[3] != 1 || nrows > 8 || src->nb[0] != sizeof(float) ||
+            (nrows == 1 && (getenv("GGML_CUDA_P60_ALL") == nullptr || atoi(getenv("GGML_CUDA_P60_ALL")) == 0)) ||
             w->ne[0] != 2048 || ggml_nelements(w) != 2048 || !ggml_is_contiguous(w) ||
             !ggml_is_contiguous(mul_tensor) || !ggml_are_same_shape(src, mul_tensor)) {
         return false;
