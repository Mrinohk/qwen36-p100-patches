+        ggml_tensor * gate = ggml_mul_mat_id(ctx, wg, x, ids);
+        ggml_tensor * out  = ggml_mul_mat_id(ctx, as, ggml_swiglu_split(ctx, gate, up), ids);
+        ggml_set_name(out, "out");
+        return out;
+    }
