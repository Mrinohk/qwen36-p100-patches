+    static const bool all = getenv("GGML_CUDA_P60_ALL") != nullptr && atoi(getenv("GGML_CUDA_P60_ALL")) != 0;
+    const int64_t n_tok = ids ? ne2 : ne11;
+    if (!all && n_tok == 1 && ne01 < 100000 && ne00 != 512) {
