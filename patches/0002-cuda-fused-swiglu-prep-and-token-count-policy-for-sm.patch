-                }
-                ggml_cuda_set_device(ctx.device);
-                CUDA_CHECK(cudaMalloc((void **) &ctx.p60_x_cache_mem, prep_bytes));
-                ctx.p60_x_cache_cap = prep_bytes;
-            }
-            prep = ctx.p60_x_cache_mem;
-            ctx.p60_x_cache_src1   = base;
-            ctx.p60_x_cache_data   = src1->data;
-            ctx.p60_x_cache_stream = stream;
-            ctx.p60_x_cache_nch    = nrows_y;
-            ctx.p60_x_cache_s[0]   = row_stride;
