+    char * prep = p60_cache_claim(ctx, mul_tensor, mul_tensor->data, stream, nrows, mul_tensor->nb[1] / sizeof(float), 2048, prep_bytes);
 
     float eps = 0.0f;
     memcpy(&eps, rms_norm->op_params, sizeof(float));
@@ -604,13 +627,94 @@ bool ggml_cuda_p60_rms_norm_mul(ggml_backend_cuda_context & ctx, const ggml_tens
         (const float *) src->data, src->nb[1] / sizeof(float), (const float *) w->data, (float *) mul_tensor->data,
         (half2 *) prep, (float2 *) (prep + xp_bytes), (float *) (prep + xp_bytes + ss_bytes), eps);
