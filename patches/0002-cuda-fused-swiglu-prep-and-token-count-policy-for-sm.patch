         return false;
     }
 
+    // same key the matvecs compute for this tensor: MUL_MAT reads it directly, MUL_MAT_ID through a reshape view
     constexpr int lpr = 2048/64;
-    const size_t xp_bytes   = nrows*lpr*32*sizeof(half2);
-    const size_t ss_bytes   = nrows*lpr*sizeof(float2);
