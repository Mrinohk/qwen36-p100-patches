+}
 
-    // same key the matvecs compute for this tensor: MUL_MAT reads it directly, MUL_MAT_ID through a reshape view
-    ctx.p60_x_cache_src1   = mul_tensor;
-    ctx.p60_x_cache_data   = mul_tensor->data;
-    ctx.p60_x_cache_stream = stream;
-    ctx.p60_x_cache_nch    = nrows;
