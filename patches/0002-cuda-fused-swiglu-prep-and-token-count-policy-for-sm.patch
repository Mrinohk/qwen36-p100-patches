+// silu(gate) * up for rows of K = 64*lpr that also writes the mmvq-p60 x layout, so ffn_down skips
+// mmvq_p60_prep_x. Same thread mapping as p60_rms_norm_mul. One block per row, blockDim = (32, lpr).
+static __global__ void __launch_bounds__(1024) p60_swiglu(
+        const char * __restrict__ gate, const char * __restrict__ up, float * __restrict__ dst, const int64_t ne1,
+        const int64_t g1, const int64_t g2, const int64_t u1, const int64_t u2,
+        half2 * __restrict__ xp, float2 * __restrict__ ss, float * __restrict__ inv_scale) {
+    const int k = threadIdx.x, l = threadIdx.y, lpr = blockDim.y, row = blockIdx.x;
+    const int g = k >> 3, i = k & 7;
+    const int c0 = 64*l + (g >= 2 ? 32 : 0) + 4*i + (g & 1);
+    const int c1 = c0 + 2;
+    const int64_t i1 = row % ne1, i2 = row / ne1;
+    const float * gr = (const float *) (gate + i1*g1 + i2*g2);
+    const float * ur = (const float *) (up   + i1*u1 + i2*u2);
+
+    const float ya = ggml_cuda_op_silu_single(gr[c0]) * ur[c0];
+    const float yb = ggml_cuda_op_silu_single(gr[c1]) * ur[c1];
+    dst[(int64_t) row*64*lpr + c0] = ya;
+    dst[(int64_t) row*64*lpr + c1] = yb;
+
+    __shared__ float red[32];
+    float amax = warp_reduce_max(fmaxf(fabsf(ya), fabsf(yb)));
+    if (k == 0) {
+        red[l] = amax;
+    }
+    __syncthreads();
+    amax = warp_reduce_max(k < lpr ? red[k] : 0.0f);
+    int e = 0;
+    frexpf(amax, &e);
+    const float scale = amax > 0.0f ? ldexpf(1.0f, 5 - e) : 1.0f;
+    if (l == 0 && k == 0) {
+        inv_scale[row] = 1.0f / scale;
+    }
+    xp[(row*lpr + l)*32 + k] = __floats2half2_rn(ya*scale, yb*scale);
+    const float lo = warp_reduce_sum(k < 16 ? ya + yb : 0.0f);
+    const float hi = warp_reduce_sum(k < 16 ? 0.0f : ya + yb);
+    if (k == 0) {
+        ss[row*lpr + l] = make_float2(lo, hi);
+    }
+}
+
+bool ggml_cuda_p60_swiglu(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    static const bool enabled = [] {
+        const char * e = getenv("GGML_CUDA_P60_MMVQ");
+        const char * f = getenv("GGML_CUDA_P60_FUSE_GLU");
+        return e != nullptr && atoi(e) != 0 && (f == nullptr || atoi(f) != 0);
+    }();
+    if (!enabled) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc >= GGML_CUDA_CC_DP4A) {
+        return false;
+    }
+
+    const ggml_tensor * gate = dst->src[0];
+    const ggml_tensor * up   = dst->src[1];
+    const int64_t K     = dst->ne[0];
+    const int64_t nrows = ggml_nrows(dst);
+    // only the routed experts: their ffn_down is a MUL_MAT_ID that mmvq-p60 takes, the shared expert's is a small stock matmul
+    const ggml_tensor * gate_src = gate->view_src ? gate->view_src : gate;
+    if (gate_src->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    if (up == nullptr || gate->type != GGML_TYPE_F32 || up->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+            K % 64 != 0 || K > 2048 || nrows > 64 || dst->ne[3] != 1 || !ggml_is_contiguous(dst) ||
+            gate->nb[0] != sizeof(float) || up->nb[0] != sizeof(float) ||
+            !ggml_are_same_shape(gate, dst) || !ggml_are_same_shape(up, dst)) {
+        return false;
+    }
+
+    cudaStream_t stream = ctx.stream();
+    if (!p60_cache_usable(ctx, stream)) {
+        return false;
+    }
+
+    // ffn_down reads dst directly: rows evenly spaced by K
+    const int lpr = K/64;
+    size_t xp_bytes, ss_bytes;
+    const size_t prep_bytes = p60_prep_bytes(nrows, lpr, &xp_bytes, &ss_bytes);
+    char * prep = p60_cache_claim(ctx, dst, dst->data, stream, nrows, K, K, prep_bytes);
+
+    p60_swiglu<<<nrows, dim3(32, lpr), 0, stream>>>(
+        (const char *) gate->data, (const char *) up->data, (float *) dst->data, dst->ne[1],
+        gate->nb[1], gate->nb[2], up->nb[1], up->nb[2],
+        (half2 *) prep, (float2 *) (prep + xp_bytes), (float *) (prep + xp_bytes + ss_bytes));
+    CUDA_CHECK(cudaGetLastError());
     return true;
 }
