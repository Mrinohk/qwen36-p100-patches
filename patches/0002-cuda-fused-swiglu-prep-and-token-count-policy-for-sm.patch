@@ -1,4 +1,5 @@
 #include "mmvq-p60.cuh"
+#include "unary.cuh"
 
 // A row has NSB superblocks. Lane slot L = sb*4 + q reads superblock sb, quarter q (64 weights, sub-blocks 2q and 2q+1),
 // so LPR = 4*NSB lanes cover a row and a warp does 32/LPR rows per pass.
@@ -359,6 +360,50 @@ static void mmvq_p60_launch(const char * vx, const char * prep, const size_t xp_
         ids, dst, nb01, nb02, n_used, ids_stride, ne11, s1, s2);
 }
 
+// Prep cache (ctx.p60_x_cache): a few slots keyed on the tensor the matvecs read (or view), its data
+// pointer, the stream, the row count, row stride and K. Rows of a cached prep are always evenly spaced.
+static bool p60_cache_usable(const ggml_backend_cuda_context & ctx, cudaStream_t stream) {
+    for (const auto & e : ctx.p60_x_cache) {
+        if (e.stream != nullptr && e.stream != stream) {
+            return false; // a buffer written on another stream would need an event
+        }
+    }
+    return true;
+}
+
+static char * p60_cache_find(ggml_backend_cuda_context & ctx, const ggml_tensor * base, const void * data,
+        cudaStream_t stream, int64_t nrows, int64_t row_stride, int64_t k) {
+    for (auto & e : ctx.p60_x_cache) {
+        if (e.mem != nullptr && e.src1 == base && e.data == data && e.stream == stream &&
+                e.nrows == nrows && e.s[0] == row_stride && e.s[1] == k) {
+            return e.mem;
+        }
+    }
+    return nullptr;
+}
+
+static char * p60_cache_claim(ggml_backend_cuda_context & ctx, const ggml_tensor * base, const void * data,
+        cudaStream_t stream, int64_t nrows, int64_t row_stride, int64_t k, size_t bytes) {
+    auto & e = ctx.p60_x_cache[ctx.p60_x_cache_next];
+    ctx.p60_x_cache_next = (ctx.p60_x_cache_next + 1) % ctx.p60_x_cache_n;
+    if (bytes > e.cap) {
+        if (e.mem != nullptr) {
+            CUDA_CHECK(cudaFree(e.mem));
+        }
+        ggml_cuda_set_device(ctx.device);
+        CUDA_CHECK(cudaMalloc((void **) &e.mem, bytes));
+        e.cap = bytes;
+    }
+    e.src1 = base; e.data = data; e.stream = stream; e.nrows = nrows; e.s[0] = row_stride; e.s[1] = k;
+    return e.mem;
+}
+
+static size_t p60_prep_bytes(int64_t nrows, int lpr, size_t * xp_bytes, size_t * ss_bytes) {
+    *xp_bytes = nrows*lpr*32*sizeof(half2);
+    *ss_bytes = nrows*lpr*sizeof(float2);
+    return *xp_bytes + *ss_bytes + nrows*sizeof(float);
+}
