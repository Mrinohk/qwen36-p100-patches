@@ -412,6 +457,15 @@ bool ggml_cuda_mmvq_p60(ggml_backend_cuda_context & ctx,
     } else if (ne1 != 1 || ne11 != 1 || ne02 != 1 || ne12 != 1 || ne03 != 1 || ne13 != 1) {
