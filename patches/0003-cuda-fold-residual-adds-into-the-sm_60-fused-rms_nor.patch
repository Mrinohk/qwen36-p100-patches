+// residual ADD(s) -> RMS_NORM -> MUL: on sm_60 with GGML_CUDA_P60_MMVQ=1 these fuse into one kernel that stores the
+// sum and the normalized output (and, for 2+ tokens, the mmvq-p60 activation layout read by the matmul)
+struct test_p60_add_norm : public test_case {
+    const int nadd;
+    const int64_t n_tokens;
+    const bool matmul;
+
+    std::string vars() override {
+        return VARS_TO_STR3(nadd, n_tokens, matmul);
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "P60_ADD_NORM";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    test_p60_add_norm(int nadd = 1, int64_t n_tokens = 1, bool matmul = false)
+        : nadd(nadd), n_tokens(n_tokens), matmul(matmul) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        const int64_t k = 2048;
+        ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n_tokens);
+        ggml_set_name(a, "a");
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n_tokens);
+        ggml_set_name(b, "b");
+        ggml_tensor * c = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n_tokens);
+        ggml_set_name(c, "c");
+        ggml_tensor * w = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, k);
+        ggml_set_name(w, "w");
+
+        ggml_tensor * sum = ggml_add(ctx, a, b);
+        if (nadd == 2) {
+            sum = ggml_add(ctx, sum, c);
+        }
+        ggml_tensor * normed = ggml_mul(ctx, ggml_rms_norm(ctx, sum, 1e-6f), w);
+        ggml_tensor * out;
+        if (matmul) {
+            ggml_tensor * as = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_K, k, 512, 16);
+            ggml_set_name(as, "as");
+            ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 16, n_tokens);
+            ggml_set_name(ids, "ids");
+            ids = ggml_view_2d(ctx, ids, 4, n_tokens, ids->nb[1], 0);
+            out = ggml_mul_mat_id(ctx, as, ggml_reshape_3d(ctx, normed, k, 1, n_tokens), ids);
+        } else {
+            out = ggml_add(ctx, normed, sum); // checks both stored outputs
+        }
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        init_mul_mat_id_tensors(ctx, 16);
+    }
+};
