+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1498,6 +1498,17 @@ struct ggml_backend_cuda_context {
         int64_t             nrows  = 0;
         int64_t             s[2]   = { 0, 0 }; // row stride, K
     };
+    // gated_delta_net input states whose GET_ROWS gather was skipped: the gdn reads cache row ids[seq] directly
+    struct p60_gdn_state_src {
+        const ggml_tensor * gdn  = nullptr;
+        const float *       base = nullptr;
+        const int32_t *     ids  = nullptr;
+        int64_t             row  = 0; // cache row stride in floats
+    };
+    static constexpr int p60_gdn_state_n = 64;
+    p60_gdn_state_src p60_gdn_state[p60_gdn_state_n];
+    int               p60_gdn_state_count = 0;
+
     static constexpr int p60_x_cache_n = 4;
     p60_x_cache_entry p60_x_cache[p60_x_cache_n];
     int               p60_x_cache_next = 0;
@@ -1515,6 +1526,7 @@ struct ggml_backend_cuda_context {
             e.stream = nullptr;
             e.nrows  = 0;
         }
+        p60_gdn_state_count = 0;
     }
 
     void q8_1_cache_free() {
