diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 93f4ec446..ee542c62d 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3552,6 +3552,45 @@ static int ggml_cuda_collect_same_op(ggml_cgraph * cgraph, int i, ggml_op op, in
 }
 
 // try and fuse nodes and return the number of nodes to skip
+// GET_ROWS that gathers a gated_delta_net's input state from the recurrent cache. With one sequence the gdn can
+// read the cache row itself (each block reads its slice of the state before it writes that slice), so the gather
+// is skipped. Returns the gdn, or nullptr.
+static const ggml_tensor * ggml_cuda_gdn_state_gather_target(const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * gr = cgraph->nodes[i];
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 || (gr->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            gr->src[0]->type != GGML_TYPE_F32 || gr->src[1]->type != GGML_TYPE_I32 ||
+            gr->src[0]->nb[0] != sizeof(float) || gr->src[1]->nb[0] != sizeof(int32_t) ||
+            gr->ne[1] != 1 || gr->ne[2] != 1 || gr->ne[3] != 1 || !ggml_is_contiguous(gr) ||
+            ggml_node_get_use_count(cgraph, i) != 1) {
+        return nullptr;
+    }
+    // follow single-use reshapes to the consumer
+    const ggml_tensor * cur = gr;
+    for (int j = i + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        bool uses = false;
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            uses = uses || n->src[s] == cur;
+        }
+        if (!uses) {
+            continue;
+        }
+        if (n->op == GGML_OP_RESHAPE || (n->op == GGML_OP_VIEW && n->view_offs == 0)) {
+            if (ggml_node_get_use_count(cgraph, j) != 1 || (n->flags & GGML_TENSOR_FLAG_OUTPUT) || !ggml_is_contiguous(n)) {
+                return nullptr;
+            }
+            cur = n;
+            continue;
+        }
+        if (n->op == GGML_OP_GATED_DELTA_NET && n->src[5] == cur && n->type == GGML_TYPE_F32 &&
+                n->src[2]->ne[3] == 1 && ggml_nelements(cur) == ggml_nelements(gr)) {
+            return n;
+        }
+        return nullptr;
+    }
+    return nullptr;
+}
+
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
     static bool disable_fusion = getenv("GGML_CUDA_DISABLE_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_FUSION"));
@@ -3561,6 +3600,21 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
+    // gated_delta_net state gather: skip it, the gdn reads the cache row (returns -1: node elided, nothing to run)
+    if (node->op == GGML_OP_GET_ROWS && cuda_ctx->p60_gdn_state_count < cuda_ctx->p60_gdn_state_n) {
+        static const bool enabled = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
+            (getenv("GGML_CUDA_P60_GDN_STATE") == nullptr || atoi(getenv("GGML_CUDA_P60_GDN_STATE")) != 0);
+        const ggml_tensor * gdn = enabled ? ggml_cuda_gdn_state_gather_target(cgraph, i) : nullptr;
+        if (gdn != nullptr) {
+            auto & e = cuda_ctx->p60_gdn_state[cuda_ctx->p60_gdn_state_count++];
+            e.gdn  = gdn;
+            e.base = (const float *) node->src[0]->data;
+            e.ids  = (const int32_t *) node->src[1]->data;
+            e.row  = node->src[0]->nb[1] / sizeof(float);
+            return -1;
+        }
+    }
+
     // residual add(s) folded into the RMS norm that follows (mmvq-p60, sm_60)
     if (node->op == GGML_OP_ADD) {
         // the allocator often puts an add in place; ggml_cuda_p60_add_rms_norm_mul allows exact aliasing only
@@ -4534,6 +4588,9 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
                 int nodes_to_skip = ggml_cuda_try_fuse(cuda_ctx, cgraph, i);
 
+                if (nodes_to_skip < 0) {
+                    continue; // node elided by the fusion that consumes it later
+                }
                 if (nodes_to_skip != 0) {
 #ifdef GGML_CUDA_DEBUG
                     const int last_fused = i + nodes_to_skip;
