-        const float * beta_pre_d, float * beta_sig_d, cudaStream_t stream) {
+        const float * beta_pre_d, float * beta_sig_d, const int32_t * s_ids, int64_t s_row, cudaStream_t stream) {
     //TODO: Add chunked kernel for even faster pre-fill
     const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
     const int num_warps = 4;
@@ -207,21 +210,21 @@ static void launch_gated_delta_net(
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K,
-                beta_pre_d, beta_sig_d);
+                beta_pre_d, beta_sig_d, s_ids, s_row);
             break;
         case 32:
             ggml_cuda_kernel_launch(gated_delta_net_cuda<32, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K,
-                beta_pre_d, beta_sig_d);
+                beta_pre_d, beta_sig_d, s_ids, s_row);
             break;
         case 64: {
             ggml_cuda_kernel_launch(gated_delta_net_cuda<64, KDA, keep_rs_t>, launch_params,
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K,
-                beta_pre_d, beta_sig_d);
+                beta_pre_d, beta_sig_d, s_ids, s_row);
             break;
         }
         case 128: {
@@ -229,7 +232,7 @@ static void launch_gated_delta_net(
                 q_d, k_d, v_d, g_d, b_d, s_d, dst_d, state_d, H,
                 n_tokens, n_seqs, sq1, sq2, sq3, sv1, sv2, sv3,
                 sb1, sb2, sb3, neqk1_magic, rq3_magic, scale, state_slot_stride, K,
-                beta_pre_d, beta_sig_d);
+                beta_pre_d, beta_sig_d, s_ids, s_row);
             break;
         }
         default:
@@ -277,6 +280,18 @@ static void ggml_cuda_op_gated_delta_net_impl(
     const float * s_d   = (const float *) src_state->data;
     float *       dst_d = (float *) dst->data;
 
+    // GET_ROWS of the input state skipped (ggml_cuda_try_fuse): read the cache row directly
+    const int32_t * s_ids = nullptr;
+    int64_t         s_row = 0;
+    for (int j = 0; j < ctx.p60_gdn_state_count; ++j) {
+        if (ctx.p60_gdn_state[j].gdn == dst) {
+            s_d   = ctx.p60_gdn_state[j].base;
+            s_ids = ctx.p60_gdn_state[j].ids;
