+void ggml_cuda_op_rms_norm_scale_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * scale_tensor) {
+    const ggml_tensor * src0 = dst->src[0];
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && scale_tensor->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(scale_tensor) && ggml_are_same_shape(dst, scale_tensor));
+
+    GGML_TENSOR_UNARY_OP_LOCALS;
+
+    float eps, post_scale, post_bias;
+    memcpy(&eps,        dst->op_params,                   sizeof(float));
+    memcpy(&post_scale, (float *) scale_tensor->op_params + 0, sizeof(float));
+    memcpy(&post_bias,  (float *) scale_tensor->op_params + 1, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    const size_t ts0 = ggml_type_size(src0->type);
+    GGML_ASSERT(nb00 == ts0);
+    rms_norm_scale_f32_cuda((const float *) src0->data, (float *) scale_tensor->data, ne00, ne01, ne02, ne03,
+        nb01 / ts0, nb02 / ts0, nb03 / ts0, eps, post_scale, post_bias, ctx.stream());
+}
