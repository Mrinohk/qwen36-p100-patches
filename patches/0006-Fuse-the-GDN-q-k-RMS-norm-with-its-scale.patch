         return 1;
     }
 
+    // RMS norm -> SCALE (the gated delta net's q/k): one kernel, same reduction and arithmetic as the two ops
+    // (not in ggml_cuda_can_fuse's list of known patterns, so the generic graph and overlap checks are called directly)
+    if (const int ns_out[] = { i + 1 }; i + 1 < cgraph->n_nodes && ggml_can_fuse(cgraph, i, { GGML_OP_RMS_NORM, GGML_OP_SCALE }) &&
+            ggml_cuda_check_fusion_memory_ranges(cgraph, i, 2, ns_out, 1)) {
+        static const bool enabled = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
+            (getenv("GGML_CUDA_P60_FUSE_NORM_SCALE") == nullptr || atoi(getenv("GGML_CUDA_P60_FUSE_NORM_SCALE")) != 0);
+        ggml_tensor * sc = cgraph->nodes[i + 1];
+        if (enabled && sc->src[0] == node && node->type == GGML_TYPE_F32 && sc->type == GGML_TYPE_F32 &&
+                ggml_is_contiguous(sc) && ggml_are_same_shape(node, sc)) {
+            ggml_cuda_op_rms_norm_scale_fused(*cuda_ctx, node, sc);
+            return 1;
+        }
+    }
+
     if (ggml_cuda_can_fuse(cgraph, i, { GGML_OP_SSM_CONV, GGML_OP_ADD, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU })) {
         ggml_cuda_op_ssm_conv(*cuda_ctx, node, cgraph->nodes[i + 1], cgraph->nodes[i + 2]);
         return 2;
