+    // update copies, run the conv with all of it
+    {
+        static const bool enabled = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
+            (getenv("GGML_CUDA_P60_FUSE_CONV_STATE") == nullptr || atoi(getenv("GGML_CUDA_P60_FUSE_CONV_STATE")) != 0);
+        auto & cs = cuda_ctx->p60_conv_state;
+        if (cs.ssm_conv != nullptr) {
+            if (node == cs.concat || (node->op == GGML_OP_CPY && node->src[0]->op == GGML_OP_VIEW && node->src[0]->src[0] == cs.concat)) {
+                return -1;
+            }
+            if (node == cs.ssm_conv) {
+                ggml_cuda_p60_ssm_conv_state(*cuda_ctx, node, cgraph->nodes[i + 1]);
+                cs = {};
+                return 1;
+            }
+        } else if (enabled && node->op == GGML_OP_GET_ROWS && ggml_cuda_p60_conv_state_plan(cuda_ctx, cgraph, i)) {
+            return -1;
+        }
+    }
+
     // gated_delta_net state gather: skip it, the gdn reads the cache row (returns -1: node elided, nothing to run)
     if (node->op == GGML_OP_GET_ROWS && cuda_ctx->p60_gdn_state_count < cuda_ctx->p60_gdn_state_n) {
         static const bool enabled = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
diff --git a/ggml/src/ggml-cuda/ssm-conv.cu b/ggml/src/ggml-cuda/ssm-conv.cu
index 1463169cf..610c8d7ef 100644
--- a/ggml/src/ggml-cuda/ssm-conv.cu
+++ b/ggml/src/ggml-cuda/ssm-conv.cu
@@ -204,3 +204,100 @@ void ggml_cuda_op_ssm_conv(ggml_backend_cuda_context & ctx, ggml_tensor * dst, g
                           out->nb[2], nc, nr, n_t, n_s, stream);
     }
 }
+
+// ssm_conv for one sequence with the conv-state shuffle folded in (mmvq-p60, GGML_CUDA_P60_FUSE_CONV_STATE).
+// Stock runs GET_ROWS (cache row -> state), CONCAT (state | new columns -> conv_input), CPY (columns of conv_input ->
+// cache rows) and then this conv on conv_input. Here each thread owns one channel: it keeps the d_conv-1 old state
+// values in registers, writes the state updates, then runs the conv with the same loads and sums as ssm_conv_f32.
+// The cache row it reads can be one it writes; only the owning thread touches a channel's values, after loading them.
+struct p60_conv_writes {
+    float * dst[ggml_backend_cuda_context::p60_conv_state_src::max_writes];
+    int     src[ggml_backend_cuda_context::p60_conv_state_src::max_writes];
+    int     n;
+};
+
+template <bool apply_silu, int d_conv>
+static __global__ void ssm_conv_state_f32(const float * base, const int32_t * ids, const int64_t row,
+                                          const float * xn, const int64_t xs_t, const int64_t xs_c,
+                                          const float * w_ptr, const int w_stride, float * y, const int64_t y_stride,
+                                          const int64_t n_t, const p60_conv_writes wr) {
+    constexpr int n_s = d_conv - 1;
+    const int c = blockIdx.y * blockDim.x + threadIdx.x;
+
+    const float * st = base + (int64_t) ids[0] * row + (int64_t) c * n_s;
+    float s[n_s];
+#pragma unroll
+    for (int j = 0; j < n_s; ++j) {
+        s[j] = st[j];
+    }
+    // column p of the stock conv_input row for this channel
+    auto win = [&](const int p) -> float {
+        if (p >= n_s) {
+            return xn[(p - n_s) * xs_t + c * xs_c];
+        }
+        float v = s[0];
+#pragma unroll
+        for (int j = 1; j < n_s; ++j) {
+            v = p == j ? s[j] : v;
+        }
+        return v;
+    };
+
+    for (int k = 0; k < wr.n; ++k) {
+        float * d = wr.dst[k] + (int64_t) c * n_s;
+#pragma unroll
+        for (int j = 0; j < n_s; ++j) {
+            d[j] = win(wr.src[k] + j);
+        }
+    }
+
+    float x[d_conv] = { 0.0f };
+    float w[d_conv] = { 0.0f };
+#pragma unroll
+    for (int j = 0; j < d_conv; j++) {
+        w[j] = w_ptr[c * w_stride + j];
+    }
+    const float b = 0.0f;
+
+    for (int64_t i = 0; i < n_t; i++) {
+        float sumf = 0.0f;
+
+        if (i == 0) {
+            for (int j = 0; j < d_conv; j++) {
+                x[j] = win(j);
+            }
+        } else {
+            x[(i - 1) % d_conv] = win(i + d_conv - 1);
+        }
+
+#pragma unroll
+        for (int j = 0; j < d_conv; j++) {
+            sumf += x[(i + j) % d_conv] * w[j];
+        }
+        sumf += b;
+        y[i * y_stride + c] = apply_silu ? ggml_cuda_op_silu_single(sumf) : sumf;
+    }
+}
+
+void ggml_cuda_p60_ssm_conv_state(ggml_backend_cuda_context & ctx, const ggml_tensor * ssm_conv, ggml_tensor * silu_dst) {
+    const auto & e = ctx.p60_conv_state;
+    GGML_ASSERT(e.ssm_conv == ssm_conv && e.n_writes <= e.max_writes);
+
+    const ggml_tensor * wt  = ssm_conv->src[1];
+    const int64_t       nc  = wt->ne[0];
+    const int64_t       nr  = ssm_conv->src[0]->ne[1];
+    const int64_t       n_t = silu_dst->ne[1];
+    GGML_ASSERT(nc == 4 && nr % 128 == 0 && silu_dst->ne[2] == 1 && silu_dst->nb[0] == sizeof(float));
+
+    p60_conv_writes wr = {};
+    wr.n = e.n_writes;
+    for (int k = 0; k < e.n_writes; ++k) {
+        wr.dst[k] = e.wdst[k];
+        wr.src[k] = e.wsrc[k];
+    }
+
+    const dim3 blocks(1, nr / 128, 1);
+    ssm_conv_state_f32<true, 4><<<blocks, 128, 0, ctx.stream()>>>(
+        e.base, e.ids, e.row, e.x, e.xs_t, e.xs_c, (const float *) wt->data, (int) (wt->nb[1] / sizeof(float)),
+        (float *) silu_dst->data, silu_dst->nb[1] / (int64_t) sizeof(float), n_t, wr);
+}
