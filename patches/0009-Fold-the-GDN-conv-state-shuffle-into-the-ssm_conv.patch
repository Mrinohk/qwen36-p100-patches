diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 75836e3a5..f4f01de05 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3591,6 +3591,104 @@ static const ggml_tensor * ggml_cuda_gdn_state_gather_target(const ggml_cgraph *
     return nullptr;
 }
 
+// Conv-state shuffle of a gated delta net layer, for one sequence and a few new tokens:
+//   GET_ROWS(cache, ids) -> RESHAPE -> CONCAT(state, new columns) -> { VIEW -> CPY into cache }* -> SSM_CONV -> SILU
+// with nothing but views and those copies between the concat and the conv. If node i is such a gather, record the
+// plan in ctx.p60_conv_state so the gather, concat and copies can be skipped and the conv does all of it.
+static bool ggml_cuda_p60_conv_state_plan(ggml_backend_cuda_context * ctx, const ggml_cgraph * cgraph, int i) {
+    const ggml_tensor * gr = cgraph->nodes[i];
+    if (gr->op != GGML_OP_GET_ROWS || gr->type != GGML_TYPE_F32 || (gr->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+            gr->src[0]->type != GGML_TYPE_F32 || gr->src[1]->type != GGML_TYPE_I32 ||
+            gr->src[0]->nb[0] != sizeof(float) || gr->ne[1] != 1 || gr->ne[2] != 1 || gr->ne[3] != 1 ||
+            !ggml_is_contiguous(gr) || ggml_node_get_use_count(cgraph, i) != 1) {
+        return false;
+    }
+    auto next_user = [&](const ggml_tensor * t, int from, int & at) -> const ggml_tensor * {
+        for (int j = from; j < cgraph->n_nodes; ++j) {
+            for (int k = 0; k < GGML_MAX_SRC; ++k) {
+                if (cgraph->nodes[j]->src[k] == t) {
+                    at = j;
+                    return cgraph->nodes[j];
+                }
+            }
+        }
+        return nullptr;
+    };
+    int ir = -1, ic = -1;
+    const ggml_tensor * rs = next_user(gr, i + 1, ir);
+    if (!rs || rs->op != GGML_OP_RESHAPE || ggml_node_get_use_count(cgraph, ir) != 1 || !ggml_is_contiguous(rs) ||
+            rs->ne[0] != 3 || rs->ne[2] != 1 || rs->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * cc = next_user(rs, ir + 1, ic);
+    if (!cc || cc->op != GGML_OP_CONCAT || cc->src[0] != rs || ggml_get_op_params_i32(cc, 0) != 0 ||
+            cc->type != GGML_TYPE_F32 || (cc->flags & GGML_TENSOR_FLAG_OUTPUT) || cc->ne[1] != rs->ne[1] ||
+            cc->ne[0] - rs->ne[0] < 1 || cc->ne[0] - rs->ne[0] > 8 || cc->ne[2] != 1 || cc->ne[3] != 1) {
+        return false;
+    }
+    const ggml_tensor * xs = cc->src[1];
+    if (xs->type != GGML_TYPE_F32 || xs->nb[0] % sizeof(float) != 0 || xs->nb[1] % sizeof(float) != 0) {
+        return false;
+    }
+
+    ggml_backend_cuda_context::p60_conv_state_src e;
+    int n_views = 0;
+    for (int j = ic + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (n->op == GGML_OP_VIEW && n->src[0] == cc) {
+            if (ggml_node_get_use_count(cgraph, j) != 1 || (n->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+                return false;
+            }
+            n_views++;
+            continue;
+        }
+        if (ggml_cuda_is_view_or_noop(n) || (n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (n->op == GGML_OP_CPY && n->src[0]->op == GGML_OP_VIEW && n->src[0]->src[0] == cc) {
+            const ggml_tensor * v = n->src[0];
+            const ggml_tensor * d = n->src[1];
+            const size_t off = v->view_offs;
+            if (e.n_writes == e.max_writes || ggml_node_get_use_count(cgraph, j) != 0 || (n->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+                    v->ne[0] != 3 || v->ne[1] != cc->ne[1] || v->ne[2] != 1 || v->nb[1] != cc->nb[1] || v->nb[0] != sizeof(float) ||
+                    off % sizeof(float) != 0 || off / sizeof(float) + 3 > (size_t) cc->ne[0] ||
+                    d->type != GGML_TYPE_F32 || !ggml_is_contiguous(d) || ggml_nelements(d) != 3 * cc->ne[1]) {
+                return false;
+            }
+            e.wdst[e.n_writes] = (float *) d->data;
+            e.wsrc[e.n_writes] = (int) (off / sizeof(float));
+            e.n_writes++;
+            continue;
+        }
+        if (n->op == GGML_OP_SSM_CONV && n->src[0] == cc && n->src[1]->ne[0] == 4 && n->src[1]->type == GGML_TYPE_F32 &&
+                n->src[1]->nb[0] == sizeof(float) && n->ne[1] == cc->ne[0] - 3 && n->ne[2] == 1 && n->ne[0] % 128 == 0 &&
+                ggml_cuda_can_fuse(cgraph, j, { GGML_OP_SSM_CONV, GGML_OP_UNARY }, { GGML_UNARY_OP_SILU }) &&
+                n_views == e.n_writes && ggml_node_get_use_count(cgraph, ic) == n_views + 1) {
+            const ggml_tensor * silu = cgraph->nodes[j + 1];
+            // the conv output may land on the new columns' buffer: fine if exactly aliased (each thread reads token t
+            // of its channel before writing it, and the state updates are written first), not if partially overlapping
+            const char * xb = (const char *) xs->data; const char * yb = (const char *) silu->data;
+            const size_t xn = ggml_nbytes(xs), yn = ggml_nbytes(silu);
+            const bool overlap = xb < yb + yn && yb < xb + xn;
+            if (silu->nb[0] != sizeof(float) || (overlap && (xb != yb || xs->nb[1] != sizeof(float) || xs->nb[0] != silu->nb[1]))) {
+                return false;
+            }
+            e.ssm_conv = n;
+            e.concat   = cc;
+            e.base     = (const float *) gr->src[0]->data;
+            e.ids      = (const int32_t *) gr->src[1]->data;
+            e.row      = gr->src[0]->nb[1] / sizeof(float);
+            e.x        = (const float *) xs->data;
+            e.xs_t     = xs->nb[0] / sizeof(float);
+            e.xs_c     = xs->nb[1] / sizeof(float);
+            ctx->p60_conv_state = e;
+            return true;
+        }
+        return false;
+    }
+    return false;
+}
+
 static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
 
     static bool disable_fusion = getenv("GGML_CUDA_DISABLE_FUSION") != nullptr && std::atoi(getenv("GGML_CUDA_DISABLE_FUSION"));
@@ -3600,6 +3698,26 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
 
     ggml_tensor * node = cgraph->nodes[i];
 
