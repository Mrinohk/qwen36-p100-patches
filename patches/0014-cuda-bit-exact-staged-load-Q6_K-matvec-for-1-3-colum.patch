From 8930b55e31888024d5b8c0765370577c12e1c4ff Mon Sep 17 00:00:00 2001
From: Mrinohk <5554998+Mrinohk@users.noreply.github.com>
Date: Mon, 5 Oct 2026 22:22:58 -0400
Subject: [PATCH 14/31] cuda : bit-exact staged-load Q6_K matvec for 1-3
 columns on sm_60

Stock MMVQ reads every Q6_K ql/qh int as two 16-bit loads, because 210-byte
q6_K blocks are only 2-byte aligned. Same fix as the staged Q8_0 kernel:
mul_mat_vec_q6_K_staged keeps stock's mapping (4 warps, 4 rows per block,
warp w takes superblock w + 4n, lane = iqs), its accumulation order and its
reduction, and calls vec_dot_q6_K_q8_1 itself, so the output is
bit-identical; but the block's 4 rows are staged through shared memory, 4
superblocks per row at a time, with coalesced 8-byte loads (rows are only
8-byte aligned, e.g. 4200 bytes at K = 5120), and the next chunk loads
during the math. Taken for dense Q6_K with 1-3 columns, K a multiple of
1024, rows % 4, on pre-Turing NVIDIA with the GENERIC table. Only with
GGML_CUDA_P60_MMVQ=1; GGML_CUDA_P60_Q6_STAGED=0 turns it off.

Qwen3.8-27B UD-Q4_K_M (GPU0): output head 248320 x 5120 4.08 -> 3.02 ms
at 1 column (each MTP draft pass), 5.60 -> 4.91 ms at 3 columns (verify);
all Q6_K per token 5.72 -> 4.19 ms (T1), 8.05 -> 7.03 ms (T3). 2x P100,
MTP n=2 8 prompts: 26.27 -> 27.66 t/s (+5.3%, two rounds), outputs
byte-identical. Wikitext KLD at ub=1 vs stock: 0, same top 100%, same PPL;
ub=3 identical to the previous build to all digits. Qwen3.6-35B decode
unchanged (85.68 vs 85.69 t/s).

Assisted-by: Claude Opus 5.5
---
 ggml/src/ggml-cuda/mmvq.cu | 130 +++++++++++++++++++++++++++++++++++++
 1 file changed, 130 insertions(+)

diff --git a/ggml/src/ggml-cuda/mmvq.cu b/ggml/src/ggml-cuda/mmvq.cu
index 837ece411..6c030a81f 100644
--- a/ggml/src/ggml-cuda/mmvq.cu
+++ b/ggml/src/ggml-cuda/mmvq.cu
@@ -1601,6 +1601,133 @@ static bool mul_mat_vec_q8_0_staged_try(const ggml_tensor * src0, const ggml_ten
     return true;
 }
 
+// Q6_K x q8_1, 1-3 columns, on the GENERIC table: same mapping, accumulation order and reduction as
+// mul_mat_vec_q<Q6_K, ncols_dst, false> (4 warps, 4 rows per block, warp w takes superblock w + 4n, lane = iqs), so the
+// output is bit-identical. The 4 rows of each 4-superblock chunk are staged through shared memory with coalesced
+// 8-byte loads (rows are 8-byte aligned) instead of 16-bit loads per weight int; the next chunk loads during the math.
+template <int ncols_dst>
+static __global__ void __launch_bounds__(4*WARP_SIZE, 1) mul_mat_vec_q6_K_staged(
+        const char * __restrict__ vx, const block_q8_1 * __restrict__ y, float * __restrict__ dst, const int64_t row_bytes,
+        const int nchunks, const int stride_col_y, const int stride_col_dst) {
+    constexpr int nwarps = 4, rows = 4, warp_size = WARP_SIZE, sbs = 4; // superblocks per row and chunk
+    constexpr int ch  = sbs*sizeof(block_q6_K)/8; // 105 uint2 per row and chunk
+    constexpr int tot = rows*ch;
+    constexpr int per = (tot + nwarps*warp_size - 1)/(nwarps*warp_size);
+    static_assert(QI6_K == 32 && VDR_Q6_K_Q8_1_MMVQ == 1 && sbs*sizeof(block_q6_K) % 8 == 0, "mapping assumes one superblock per warp");
+
+    __shared__ uint2 sm[tot];
+    const int tid  = warp_size*threadIdx.y + threadIdx.x;
+    const int row0 = rows*blockIdx.x;
+
+    uint2 g[per];
+    auto load = [&](const int c) {
+#pragma unroll
+        for (int j = 0; j < per; ++j) {
+            const int idx = tid + nwarps*warp_size*j;
+            if (idx < tot) {
+                g[j] = __ldg((const uint2 *) (vx + (int64_t) (row0 + idx/ch)*row_bytes) + c*ch + idx % ch);
+            }
+        }
+    };
+    load(0);
+
+    float tmp[ncols_dst][rows] = {{ 0.0f }};
+    for (int c = 0; c < nchunks; ++c) {
+        if (c > 0) {
+            __syncthreads();
+        }
+#pragma unroll
+        for (int j = 0; j < per; ++j) {
+            const int idx = tid + nwarps*warp_size*j;
+            if (idx < tot) {
+                sm[idx] = g[j];
+            }
+        }
+        __syncthreads();
+        if (c + 1 < nchunks) {
+            load(c + 1);
+        }
+        const int kby = (c*sbs + threadIdx.y) * (QK_K/QK8_1);
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows; ++i) {
+                tmp[j][i] += vec_dot_q6_K_q8_1((const char *) (sm + i*ch), &y[j*stride_col_y + kby], threadIdx.y, threadIdx.x);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1][ncols_dst][rows][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i) {
+                dst[j*stride_col_dst + row0 + i] = tmp[j][i];
+            }
+        }
+    }
+}
+
+// Takes dense Q6_K with 1-3 columns when the staged kernel above reproduces stock exactly; returns false otherwise.
+// Only with GGML_CUDA_P60_MMVQ=1; GGML_CUDA_P60_Q6_STAGED=0 turns it off.
+static bool mul_mat_vec_q6_K_staged_try(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, const ggml_tensor * dst,
+        const ggml_cuda_mm_fusion_args_host * fusion, const char * src1_q8_1, const int64_t stride_col_y, const int64_t stride_col_dst,
+        cudaStream_t stream) {
+    static const bool enabled = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
+        (getenv("GGML_CUDA_P60_Q6_STAGED") == nullptr || atoi(getenv("GGML_CUDA_P60_Q6_STAGED")) != 0);
+    if (!enabled || src0->type != GGML_TYPE_Q6_K || ids != nullptr) {
+        return false;
+    }
+    if (fusion && (fusion->gate || fusion->x_bias || fusion->gate_bias || fusion->x_scale || fusion->gate_scale)) {
+        return false;
+    }
+    const int64_t ncols = src1->ne[1];
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc >= GGML_CUDA_CC_DP4A || get_device_table_id(cc) != MMVQ_PARAMETERS_GENERIC ||
+            ncols < 1 || ncols > 3 || calc_nwarps(GGML_TYPE_Q6_K, ncols, MMVQ_PARAMETERS_GENERIC) != 4 ||
+            calc_rows_per_block(ncols, MMVQ_PARAMETERS_GENERIC) != 4) {
+        return false;
+    }
+    const int64_t ne00 = src0->ne[0], ne01 = src0->ne[1];
+    if (ne00 % (4*QK_K) != 0 || ne01 % 4 != 0 || src0->ne[2] != 1 || src0->ne[3] != 1 ||
+            src1->ne[2] != 1 || src1->ne[3] != 1 || dst->ne[1] != ncols || dst->ne[2] != 1 || dst->ne[3] != 1 ||
+            src0->nb[1] != (size_t) ne00/QK_K*sizeof(block_q6_K) || ((uintptr_t) src0->data) % 8 != 0 ||
+            dst->nb[0] != sizeof(float)) {
+        return false;
+    }
+    const dim3 grid(ne01/4), block(WARP_SIZE, 4);
+    const int nchunks = ne00/(4*QK_K);
+    const char * vx = (const char *) src0->data;
+    const block_q8_1 * y = (const block_q8_1 *) src1_q8_1;
+    float * d = (float *) dst->data;
+    switch (ncols) {
+        case 1: mul_mat_vec_q6_K_staged<1><<<grid, block, 0, stream>>>(vx, y, d, src0->nb[1], nchunks, stride_col_y, stride_col_dst); break;
+        case 2: mul_mat_vec_q6_K_staged<2><<<grid, block, 0, stream>>>(vx, y, d, src0->nb[1], nchunks, stride_col_y, stride_col_dst); break;
+        default: mul_mat_vec_q6_K_staged<3><<<grid, block, 0, stream>>>(vx, y, d, src0->nb[1], nchunks, stride_col_y, stride_col_dst); break;
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
+
 void ggml_cuda_mul_mat_vec_q(
         ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst,
         const ggml_cuda_mm_fusion_args_host * fusion) {
@@ -1783,6 +1910,9 @@ void ggml_cuda_mul_mat_vec_q(
     if (mul_mat_vec_q8_0_staged_try(src0, src1, ids, dst, fusion, src1_q8_1_d, stream)) {
         return;
     }
+    if (mul_mat_vec_q6_K_staged_try(src0, src1, ids, dst, fusion, src1_q8_1_d, stride_col_y, stride_col_dst, stream)) {
+        return;
+    }
 
     mul_mat_vec_q_switch_type(
         src0->data, src0->type, src1_q8_1_d, ids_d, fusion_local, dst_d, ne00,
-- 
