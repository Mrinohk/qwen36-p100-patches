From 434413e2bc72db74f8499e48e13e61f7300177b1 Mon Sep 17 00:00:00 2001
From: Mrinohk <5554998+Mrinohk@users.noreply.github.com>
Date: Tue, 6 Oct 2026 13:20:44 -0400
Subject: [PATCH 15/31] cuda : use CUBLAS_GEMM_ALGO6 for long-row f16 GEMMs on
 GP100

On sm_60 the default cuBLAS heuristic picks slow kernels for the prefill
GEMMs of models with wide layers, worst at 512-1024 columns: over
Qwen3.8-27B's weight shapes the whole-model GEMM time at 768 columns is
4.52 s with the default and 2.54 s with CUBLAS_GEMM_ALGO6 (ffn_down
17408 -> 5120: 32.0 vs 9.0 ms). ALGO6 was faster at every measured column
count from 64 to 4096 for shapes with K >= 5120 (lab/hgemm_smalln.cu);
for K <= 4096 (Qwen3.6-35B's dense shapes) it is mixed, so those keep the
default. Falls back to the default if cuBLAS refuses the algorithm. Only
with GGML_CUDA_P60_MMVQ=1; GGML_CUDA_P60_GEMM_ALGO=0 turns it off.

Qwen3.8-27B UD-Q4_K_M, 2x P100, llama-bench prefill: pp256 118.9 ->
174.4, pp512 139.0 -> 200.0, pp768 141.1 -> 208.5, pp1024 160.3 -> 213.0,
pp2048 215.0 -> 214.2 t/s. Not bit-exact, but closer to the decode path:
wikitext at ub=512 vs the ub=1 logits, KLD 0.0071 -> 0.00055, same top
94.7% -> 98.6%, PPL ratio 1.0066 -> 1.0017.

Assisted-by: Claude Opus 5.5
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index f4f01de05..d551c5d1b 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -1551,14 +1551,32 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
                                            (const float *) src1_ptr, s11,
                     (const float *) beta,  (float       *)  dst_ptr, ne0));
     } else if (ne12 == 1 && ne13 == 1) {
-        CUBLAS_CHECK(
-            cublasGemmEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
+        // GP100, f16 compute, long rows (K >= 5120): the default heuristic picks slow kernels, worst at 512-1024
+        // columns (ffn_down 17408 -> 5120 at 768 columns: 32 ms vs 9 ms). CUBLAS_GEMM_ALGO6 is faster at every
+        // measured column count (64-4096) for these shapes; for K <= 4096 it is mixed, so those keep the default.
+        // Only with GGML_CUDA_P60_MMVQ=1; GGML_CUDA_P60_GEMM_ALGO=0 turns it off. Falls back if algo 6 is refused.
+        static const bool p60_algo = getenv("GGML_CUDA_P60_MMVQ") != nullptr && atoi(getenv("GGML_CUDA_P60_MMVQ")) != 0 &&
+            (getenv("GGML_CUDA_P60_GEMM_ALGO") == nullptr || atoi(getenv("GGML_CUDA_P60_GEMM_ALGO")) != 0);
+        cublasStatus_t st = CUBLAS_STATUS_NOT_SUPPORTED;
+        if (p60_algo && cc == GGML_CUDA_CC_PASCAL && cu_compute_type == CUBLAS_COMPUTE_16F && ne10 >= 5120) {
+            st = cublasGemmEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
                     ne01, ne11, ne10,
                     alpha, src0_ptr, cu_data_type_a, s01,
                            src1_ptr, cu_data_type_b, s11,
                     beta,   dst_ptr, cu_data_type,   ne0,
                     cu_compute_type,
-                    CUBLAS_GEMM_DEFAULT_TENSOR_OP));
+                    CUBLAS_GEMM_ALGO6);
+        }
+        if (st != CUBLAS_STATUS_SUCCESS) {
+            CUBLAS_CHECK(
+                cublasGemmEx(cublas_h, CUBLAS_OP_T, CUBLAS_OP_N,
+                        ne01, ne11, ne10,
+                        alpha, src0_ptr, cu_data_type_a, s01,
+                               src1_ptr, cu_data_type_b, s11,
+                        beta,   dst_ptr, cu_data_type,   ne0,
+                        cu_compute_type,
+                        CUBLAS_GEMM_DEFAULT_TENSOR_OP));
+        }
     } else if (r2 == 1 && r3 == 1 && is_src0_cont_2 && is_src1_cont_2) {
         // with a [0, 2, 1, 3] perm. and ne02==1 the matrix strides need to be determined from dim 3:
         const int64_t sma = ne02 == 1 ? s03 : s02;
-- 
