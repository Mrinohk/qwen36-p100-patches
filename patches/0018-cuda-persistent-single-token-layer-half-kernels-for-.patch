 }
 
+// ---- persistent single-token layer halves (p60-mega.cu), GGML_CUDA_P60_MEGA=1 ----
+// A half of a Qwen3.5/3.6 MoE layer starts at the RMS_NORM of its input and ends at the residual ADD. The matchers
+// identify every node in that range by op and weight name and fail on anything else, so other graphs (snapshot
+// state, other quant types, extra get_rows on the last layer, ...) keep the normal path.
+
+static bool p60_is_weight(const ggml_tensor * t, int il, const char * suffix) {
+    char buf[128];
+    snprintf(buf, sizeof(buf), "blk.%d.%s", il, suffix);
+    return t != nullptr && strcmp(t->name, buf) == 0;
+}
+
+static bool p60_is_node(const ggml_tensor * t, const char * base, int il) {
+    char buf[128];
+    snprintf(buf, sizeof(buf), "%s-%d", base, il);
+    return t != nullptr && strcmp(t->name, buf) == 0;
+}
+
+static const ggml_tensor * p60_view_root(const ggml_tensor * t) {
+    while (t->view_src != nullptr) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+// the tensors computed in nodes [beg, end] are not graph outputs and not read by the next nodes, except keep
+static bool p60_range_private(const ggml_cgraph * g, int beg, int end, const ggml_tensor * keep) {
+    for (int k = beg; k <= end; k++) {
+        const ggml_tensor * t = g->nodes[k];
+        if (t != keep && (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return false;
+        }
+    }
+    const int lim = std::min(g->n_nodes, end + 400);
+    for (int k = end + 1; k < lim; k++) {
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            const ggml_tensor * src = g->nodes[k]->src[j];
+            if (src == nullptr) {
+                continue;
+            }
+            const ggml_tensor * r = p60_view_root(src);
+            if (r == keep || p60_view_root(keep) == r) {
+                continue;
+            }
+            for (int m = beg; m <= end; m++) {
+                if (g->nodes[m] == r || g->nodes[m] == src) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static bool p60_f32_vec(const ggml_tensor * t, int64_t n) {
+    return t != nullptr && t->type == GGML_TYPE_F32 && ggml_nelements(t) == n && ggml_is_contiguous(t);
+}
+
+static bool p60_mat(const ggml_tensor * t, ggml_type type, int64_t ne0, int64_t ne1, int64_t ne2 = 1) {
+    return t != nullptr && t->type == type && t->ne[0] == ne0 && t->ne[1] == ne1 && t->ne[2] == ne2 && t->ne[3] == 1 &&
+        ggml_is_contiguous(t) && ((uintptr_t) t->data) % 16 == 0;
+}
+
+// GGML_CUDA_P60_MEGA_DEBUG=1: log why a match attempt failed (first 40 failures)
+static int p60_mega_fail(int line, const ggml_tensor * t, const ggml_tensor * at = nullptr) {
+    static const bool dbg = getenv("GGML_CUDA_P60_MEGA_DEBUG") != nullptr;
+    static std::map<int, int> n;
+    if (dbg && t->ne[1] == 1 && n[line]++ < 12) {
+        fprintf(stderr, "p60-mega: no match at line %d (%s %s) at %s %s src0 %s src1 %s\n", line, ggml_op_desc(t), t->name,
+            at ? ggml_op_desc(at) : "-", at ? at->name : "-", at && at->src[0] ? at->src[0]->name : "-", at && at->src[1] ? at->src[1]->name : "-");
+    }
+    return 0;
+}
+#define P60_MEGA_FAIL return p60_mega_fail(__LINE__, g->nodes[i], cur_t)
+
+static int p60_try_mega_gdn(ggml_backend_cuda_context * ctx, ggml_cgraph * g, int i, bool dry = false) {
+    const ggml_tensor * norm = g->nodes[i];
+    const ggml_tensor * cur_t = nullptr;
+    if (i + 2 >= g->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * nmul = g->nodes[i + 1];
+    if (nmul->op != GGML_OP_MUL || nmul->src[0] != norm || nmul->src[1] == nullptr) {
+        return 0;
+    }
+    int il = -1;
+    if (sscanf(nmul->src[1]->name, "blk.%d.attn_norm.weight", &il) != 1 || !p60_is_weight(nmul->src[1], il, "attn_norm.weight")) {
+        return 0;
+    }
+    int e = -1;
+    for (int k = i + 2; k < g->n_nodes && k < i + 120; k++) {
+        if (g->nodes[k]->op == GGML_OP_ADD && p60_is_node(g->nodes[k], "attn_residual", il)) {
+            e = k;
+            break;
+        }
+    }
+    if (e < 0) {
+        P60_MEGA_FAIL;
+    }
+    ggml_cuda_p60_mega_gdn_args a = {};
+    const ggml_tensor * qkv = nullptr, * z = nullptr, * out = nullptr, * alpha = nullptr, * beta = nullptr;
+    const ggml_tensor * dt = nullptr, * ssa = nullptr, * conv = nullptr, * snorm = nullptr, * cs_get = nullptr, * ss_get = nullptr;
+    const ggml_tensor * cs_cpy = nullptr, * ss_cpy = nullptr, * gdn = nullptr;
+    float eps_l2 = -1.0f, scale_l2 = -1.0f, eps_gn = -1.0f;
+    ggml_tensor * prerun[8];
+    int n_prerun = 0;
+    for (int k = i + 2; k < e; k++) {
+        ggml_tensor * t = g->nodes[k];
+        cur_t = t;
+        switch (t->op) {
+            case GGML_OP_RESHAPE: case GGML_OP_VIEW: case GGML_OP_TRANSPOSE: case GGML_OP_PERMUTE: case GGML_OP_NONE:
+            case GGML_OP_CONCAT:
+                break;
+            case GGML_OP_MUL_MAT:
+                if      (p60_is_weight(t->src[0], il, "attn_qkv.weight"))  { qkv   = t->src[0]; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "attn_gate.weight")) { z     = t->src[0]; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "ssm_alpha.weight")) { alpha = t->src[0]; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "ssm_beta.weight"))  { beta  = t->src[0]; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "ssm_out.weight"))   { out   = t->src[0]; }
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_GET_ROWS:
+                if (ggml_nelements(t) == 0) {
+                    break;
+                }
+                if (p60_is_node(t, "conv_states", il)) {
+                    cs_get = t;
+                } else if (t->src[0]->ne[0] == 128*128*32) {
+                    ss_get = t;
+                } else {
+                    P60_MEGA_FAIL;
+                }
+                break;
+            case GGML_OP_CPY:
+                if (ggml_nelements(t) == 0) {
+                    break;
+                }
+                if (p60_is_node(t->src[0], "conv_state_last", il)) {
+                    cs_cpy = t;
+                } else if (p60_is_node(t->src[0], "new_state", il)) {
+                    ss_cpy = t;
+                } else {
+                    P60_MEGA_FAIL;
+                }
+                break;
+            case GGML_OP_SCALE: {
+                float sc, bias;
+                memcpy(&sc, (const float *) t->op_params + 0, sizeof(float));
+                memcpy(&bias, (const float *) t->op_params + 1, sizeof(float));
+                if (t->src[0]->op == GGML_OP_RMS_NORM) {
+                    if (bias != 0.0f || (scale_l2 >= 0.0f && scale_l2 != sc)) P60_MEGA_FAIL;
+                    scale_l2 = sc;
+                } else if (t->view_src != nullptr && n_prerun < 8) {
+                    if (ggml_nelements(t) > 0) {
+                        prerun[n_prerun++] = t; // in-place clear of a cache row: run it as is, before the kernel
+                    }
+                } else {
+                    P60_MEGA_FAIL;
+                }
+                break;
+            }
+            case GGML_OP_RMS_NORM: {
+                float eps;
+                memcpy(&eps, t->op_params, sizeof(float));
+                if (p60_is_node(t->src[0], "q_conv", il) || p60_is_node(t->src[0], "k_conv", il)) {
+                    if (eps_l2 >= 0.0f && eps_l2 != eps) P60_MEGA_FAIL;
+                    eps_l2 = eps;
+                } else if (p60_is_node(t->src[0], "attn_output", il)) {
+                    eps_gn = eps;
+                } else {
+                    P60_MEGA_FAIL;
+                }
+                break;
+            }
+            case GGML_OP_SSM_CONV:
+                conv = t->src[1];
+                break;
+            case GGML_OP_UNARY: {
+                const ggml_unary_op u = ggml_get_unary_op(t);
+                if (u != GGML_UNARY_OP_SILU && u != GGML_UNARY_OP_SOFTPLUS && u != GGML_UNARY_OP_SIGMOID) P60_MEGA_FAIL;
+                break;
+            }
+            case GGML_OP_ADD:
+                if (!p60_is_weight(t->src[1], il, "ssm_dt.bias")) P60_MEGA_FAIL;
+                dt = t->src[1];
+                break;
+            case GGML_OP_MUL:
+                if      (p60_is_weight(t->src[1], il, "ssm_a"))            ssa   = t->src[1];
+                else if (p60_is_weight(t->src[1], il, "ssm_norm.weight"))  snorm = t->src[1];
+                else if (t->src[1]->op != GGML_OP_UNARY)                   P60_MEGA_FAIL; // gated norm: norm * silu(z)
+                break;
+            case GGML_OP_GATED_DELTA_NET:
+                gdn = t;
+                break;
+            default:
+                P60_MEGA_FAIL;
+        }
+    }
+    const ggml_tensor * add = g->nodes[e];
+    if (!qkv || !z || !out || !alpha || !beta || !dt || !ssa || !conv || !snorm || !cs_get || !ss_get || !cs_cpy || !ss_cpy || !gdn ||
+            eps_l2 < 0.0f || scale_l2 < 0.0f || eps_gn < 0.0f || add->src[1] != norm->src[0]) {
+        P60_MEGA_FAIL;
+    }
+    // single token, single sequence, no state snapshots (output = attention values + one state)
+    if (gdn->src[0]->ne[2] != 1 || gdn->src[0]->ne[3] != 1 || gdn->ne[0] != 4096 || gdn->ne[1] != 128 + 1 ||
+            !p60_mat(qkv, GGML_TYPE_Q8_0, 2048, 8192) || !p60_mat(z, GGML_TYPE_Q8_0, 2048, 4096) || !p60_mat(out, GGML_TYPE_Q8_0, 4096, 2048) ||
+            !p60_mat(alpha, GGML_TYPE_F32, 2048, 32) || !p60_mat(beta, GGML_TYPE_F32, 2048, 32) || !p60_mat(conv, GGML_TYPE_F32, 4, 8192) ||
+            !p60_f32_vec(dt, 32) || !p60_f32_vec(ssa, 32) || !p60_f32_vec(snorm, 128) || !p60_f32_vec(nmul->src[1], 2048) ||
+            !p60_f32_vec(norm->src[0], 2048) || !p60_f32_vec(add, 2048) ||
+            cs_get->src[0]->nb[1] != 3*8192*sizeof(float) || ss_get->src[0]->nb[1] != 128*128*32*sizeof(float) ||
+            cs_get->src[1]->type != GGML_TYPE_I32 || ss_get->src[1]->type != GGML_TYPE_I32 ||
+            ggml_nelements(cs_cpy) != 3*8192 || ggml_nelements(ss_cpy) != 128*128*32 || !ggml_is_contiguous(cs_cpy) || !ggml_is_contiguous(ss_cpy) ||
+            !p60_range_private(g, i, e, add)) {
+        P60_MEGA_FAIL;
+    }
+    if (dry) {
+        return e - i;
+    }
+    memcpy(&a.eps_norm, norm->op_params, sizeof(float));
+    a.x_in = (const float *) norm->src[0]->data;  a.x_out = (float *) add->data;
+    a.attn_norm = (const float *) nmul->src[1]->data;
+    a.qkv = (const char *) qkv->data; a.z = (const char *) z->data; a.out = (const char *) out->data;
+    a.alpha = (const float *) alpha->data; a.beta = (const float *) beta->data;
+    a.dt = (const float *) dt->data; a.a = (const float *) ssa->data; a.conv = (const float *) conv->data; a.snorm = (const float *) snorm->data;
+    a.eps_l2 = eps_l2; a.scale_l2 = scale_l2; a.eps_gn = eps_gn;
+    a.cs_base = (const float *) cs_get->src[0]->data; a.cs_ids = (const int32_t *) cs_get->src[1]->data; a.cs_row = cs_get->src[0]->nb[1] / sizeof(float);
+    a.cs_out = (float *) cs_cpy->data;
+    a.ss_base = (const float *) ss_get->src[0]->data; a.ss_ids = (const int32_t *) ss_get->src[1]->data; a.ss_row = ss_get->src[0]->nb[1] / sizeof(float);
+    a.ss_out = (float *) ss_cpy->data;
+    for (int k = 0; k < n_prerun; k++) {
+        ggml_cuda_compute_forward(*ctx, prerun[k]);
+    }
+    ggml_cuda_p60_mega_gdn(*ctx, a);
+    return e - i;
+}
+
+static int p60_try_mega_moe(ggml_backend_cuda_context * ctx, ggml_cgraph * g, int i, bool dry = false) {
+    const ggml_tensor * norm = g->nodes[i];
+    const ggml_tensor * cur_t = nullptr;
+    if (i + 2 >= g->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * nmul = g->nodes[i + 1];
+    if (nmul->op != GGML_OP_MUL || nmul->src[0] != norm || nmul->src[1] == nullptr) {
+        return 0;
+    }
+    int il = -1;
+    if (sscanf(nmul->src[1]->name, "blk.%d.post_attention_norm.weight", &il) != 1 || !p60_is_weight(nmul->src[1], il, "post_attention_norm.weight")) {
+        return 0;
+    }
+    int e = -1;
+    for (int k = i + 2; k < g->n_nodes && k < i + 100; k++) {
+        const ggml_tensor * t = g->nodes[k];
+        if (t->op == GGML_OP_ADD && t->src[1] == norm->src[0] && p60_is_node(t, "l_out", il)) {
+            e = k;
+            break;
+        }
+    }
+    if (e < 0) {
+        P60_MEGA_FAIL;
+    }
+    const ggml_tensor * router = nullptr, * sgate = nullptr, * gate = nullptr, * up = nullptr, * down = nullptr;
+    const ggml_tensor * sg = nullptr, * su = nullptr, * sd = nullptr, * ids = nullptr;
+    int n_softmax = 0, n_div = 0;
+    for (int k = i + 2; k < e; k++) {
+        const ggml_tensor * t = g->nodes[k];
+        cur_t = t;
+        switch (t->op) {
+            case GGML_OP_RESHAPE: case GGML_OP_VIEW: case GGML_OP_TRANSPOSE: case GGML_OP_PERMUTE: case GGML_OP_NONE:
+            case GGML_OP_ARGSORT: case GGML_OP_GET_ROWS: case GGML_OP_SUM_ROWS: case GGML_OP_CLAMP: case GGML_OP_GLU:
+            case GGML_OP_ADD: case GGML_OP_MUL:
+                break;
+            case GGML_OP_DIV:
+                n_div++;
+                break;
+            case GGML_OP_SOFT_MAX: {
+                float scale, max_bias;
+                memcpy(&scale, (const float *) t->op_params + 0, sizeof(float));
+                memcpy(&max_bias, (const float *) t->op_params + 1, sizeof(float));
+                if (t->src[1] != nullptr || scale != 1.0f || max_bias != 0.0f) P60_MEGA_FAIL;
+                n_softmax++;
+                break;
+            }
+            case GGML_OP_UNARY:
+                if (ggml_get_unary_op(t) != GGML_UNARY_OP_SIGMOID) P60_MEGA_FAIL;
+                break;
+            case GGML_OP_MUL_MAT:
+                if      (p60_is_weight(t->src[0], il, "ffn_gate_inp.weight"))       router = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_gate_inp_shexp.weight")) sgate  = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_gate_shexp.weight"))     sg     = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_up_shexp.weight"))       su     = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_down_shexp.weight"))     sd     = t->src[0];
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_MUL_MAT_ID:
+                if      (p60_is_weight(t->src[0], il, "ffn_gate_exps.weight")) gate = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_up_exps.weight"))   up   = t->src[0];
+                else if (p60_is_weight(t->src[0], il, "ffn_down_exps.weight")) down = t->src[0];
+                else P60_MEGA_FAIL;
+                ids = t->src[2];
+                if (t->src[1]->ne[2] != 1) P60_MEGA_FAIL; // one token
+                break;
+            default:
+                P60_MEGA_FAIL;
+        }
+    }
+    const ggml_tensor * add = g->nodes[e];
+    if (!router || !sgate || !gate || !up || !down || !sg || !su || !sd || !ids || n_softmax != 1 || n_div != 1 ||
+            ids->ne[0] != 8 || ids->ne[1] != 1 ||
+            !p60_mat(router, GGML_TYPE_F32, 2048, 256) || !p60_f32_vec(sgate, 2048) ||
+            !p60_mat(gate, GGML_TYPE_Q4_K, 2048, 512, 256) || !p60_mat(up, GGML_TYPE_Q4_K, 2048, 512, 256) ||
+            !p60_mat(down, GGML_TYPE_Q5_K, 512, 2048, 256) ||
+            !p60_mat(sg, GGML_TYPE_Q8_0, 2048, 512) || !p60_mat(su, GGML_TYPE_Q8_0, 2048, 512) || !p60_mat(sd, GGML_TYPE_Q8_0, 512, 2048) ||
+            !p60_f32_vec(nmul->src[1], 2048) || !p60_f32_vec(norm->src[0], 2048) || !p60_f32_vec(add, 2048) ||
+            !p60_range_private(g, i, e, add)) {
+        P60_MEGA_FAIL;
+    }
+    if (dry) {
+        return e - i;
+    }
+    ggml_cuda_p60_mega_moe_args a = {};
+    a.x_in = (const float *) norm->src[0]->data; a.x_out = (float *) add->data;
+    a.norm = (const float *) nmul->src[1]->data;
+    memcpy(&a.eps, norm->op_params, sizeof(float));
+    a.router = (const float *) router->data; a.sgate = (const float *) sgate->data;
+    a.gate = (const char *) gate->data; a.up = (const char *) up->data; a.down = (const char *) down->data;
