+#pragma once
+
+#include "common.cuh"
+
+// Persistent single-token kernels for the Qwen3.5/3.6 MoE layer halves on sm_60 (GGML_CUDA_P60_MEGA=1).
+// One cooperative launch runs a whole half of a layer: all blocks stay resident and sync with a grid barrier
+// between phases, so the ~30 small kernels of a half become 3 phases.
+
+// gated delta net half: attn_norm -> qkv (+ conv, silu, conv-state update), z, alpha, beta -> recurrence (+ state
+// update) -> gated norm -> ssm_out -> residual add
+struct ggml_cuda_p60_mega_gdn_args {
+    const float * x_in;      // layer input [2048]
+    float *       x_out;     // attn_residual [2048]
+    const float * attn_norm; // [2048]
+    float         eps_norm;
+    const char *  qkv;       // Q8_0 [8192 rows of 2048]
+    const char *  z;         // Q8_0 [4096 rows of 2048]
+    const char *  out;       // Q8_0 [2048 rows of 4096]
+    const float * alpha;     // [32 rows of 2048]
+    const float * beta;      // [32 rows of 2048]
+    const float * dt;        // [32]
+    const float * a;         // [32]
+    const float * conv;      // [8192][4]
+    const float * snorm;     // [128]
+    float         eps_l2;    // rms_norm eps of the q/k l2 norm
+    float         scale_l2;  // scale after it
+    float         eps_gn;    // rms_norm eps of the gated norm
+    const float * cs_base;   // conv-state cache, row cs_ids[0] is read
+    const int32_t * cs_ids;
+    int64_t       cs_row;    // row stride in floats
+    float *       cs_out;    // updated conv state
+    const float * ss_base;   // recurrent-state cache, row ss_ids[0] is read
+    const int32_t * ss_ids;
+    int64_t       ss_row;
+    float *       ss_out;    // updated recurrent state
+};
+
+// MoE half: post-attention norm -> router top-8 + shared expert gate -> expert gate/up + shared down -> expert down,
+// weighted sum, shared expert -> residual add
+struct ggml_cuda_p60_mega_moe_args {
+    const float * x_in;   // attn_residual [2048]
+    float *       x_out;  // l_out [2048]
+    const float * norm;   // post_attention_norm [2048]
+    float         eps;
+    const float * router; // [256 rows of 2048]
+    const float * sgate;  // [2048]
+    const char *  gate;   // Q4_K [256][512 rows of 2048]
+    const char *  up;     // Q4_K
+    const char *  down;   // Q5_K [256][2048 rows of 512]
+    const char *  sg;     // Q8_0 [512 rows of 2048]
+    const char *  su;     // Q8_0
+    const char *  sd;     // Q8_0 [2048 rows of 512]
+};
+
+void ggml_cuda_p60_mega_gdn(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_gdn_args & args);
+void ggml_cuda_p60_mega_moe(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_moe_args & args);
