+            }
+        } else {
+            for (int t = warp - 2 * TM; t < T; t += NW - 2 * TM) {
+                const float * gu = P.shgu + t * 2 * FF + 16 * lane;
+                float4 g4[4], u4[4];
+#pragma unroll
+                for (int i = 0; i < 4; i++) { g4[i] = __ldcg((const float4 *) gu + i); u4[i] = __ldcg((const float4 *) (gu + FF) + i); }
+#pragma unroll
+                for (int i = 0; i < 4; i++) {
+                    const float g[4] = {g4[i].x, g4[i].y, g4[i].z, g4[i].w}, u_[4] = {u4[i].x, u4[i].y, u4[i].z, u4[i].w};
+#pragma unroll
+                    for (int c = 0; c < 4; c++) ash16[t * AS + pp(16 * lane + 4 * i + c)] = __float2half(silu(g[c]) * u_[c]);
+                }
+            }
+        }
+        __syncthreads();
+        // groups of 4 rows per warp: lane = row in group * 8 + superblock * 4 + chunk
+        const int sb = (lane >> 2) & 1, q = lane & 3, ri = lane >> 3;
+        auto q5at = [&](int g) { return load_q5k(W.down + ((size_t) ulist[g / D] * D + g % D + ri) * Q5K_ROW + sb * 176, q); };
+        int g0 = r0 + 4 * warp;
+        q5_ld Lc;
+        if (g0 < r1) Lc = q5at(g0);
+        for (; g0 < r1; g0 += 4 * NW) {
+            q5_ld Ln;
+            if (g0 + 4 * NW < r1) Ln = q5at(g0 + 4 * NW); // next group's loads in flight during this group's math
+            const int u = g0 / D, r = g0 % D + ri;
+            w64 w;
+            prep_q5k(Lc, q, w);
+            Lc = Ln;
+            const int base = sb * 256 + 64 * q, j0 = base >> 5;
+            const __half * a16 = act16 + (u - ulo) * TM * AS;
+            const float * as = asum + (u - ulo) * TM * 16;
+            for (unsigned m = umaskl[u]; m; m &= m - 1) {
+                const int t = __ffs(m) - 1;
+                float a = dot1(w, a16 + t * AS, base, as[t * 16 + j0], as[t * 16 + j0 + 1]);
+                a += __shfl_xor_sync(0xffffffff, a, 4); a += __shfl_xor_sync(0xffffffff, a, 2); a += __shfl_xor_sync(0xffffffff, a, 1);
+                if ((lane & 7) == 0) {
+                    const int k = kof[u][t];
+                    P.ypart[((size_t) t * NU + k) * D + r] = selw[t][k] * a;
+                }
+            }
+        }
+        // shared down: pairs of q8_0 rows (K = 512) for all tokens
+        for (int u = gw; u < D / 2; u += nwg) {
+            stage_row(stage[warp], W.sd + (size_t) 2 * u * Q8_ROW_F, 2 * Q8_ROW_F, lane);
+            const int sub = lane >> 4, blk = lane & 15;
+            float acc[TM];
+#pragma unroll
+            for (int t = 0; t < TM; t++) acc[t] = 0.f;
+            dot_q8h_T(stage[warp] + sub * Q8_ROW_F, blk, blk, ash16, AS, T, acc);
+            __syncwarp();
+#pragma unroll
+            for (int t = 0; t < TM; t++) {
+                float a = acc[t];
+                for (int o = 8; o > 0; o >>= 1) a += __shfl_xor_sync(0xffffffff, a, o);
+                if (t < T && blk == 0) P.shout[t * D + 2 * u + sub] = a;
+            }
+        }
+    }
+    tsync(P.bar, target);
+
+    // ---- P4: combine ----
+    for (int idx = blockIdx.x * NT + threadIdx.x; idx < T * D; idx += gridDim.x * NT) {
+        const int t = idx / D, r = idx % D;
+        float y = 0.f;
+#pragma unroll
+        for (int k = 0; k < NU; k++) y += __ldcg(P.ypart + ((size_t) t * NU + k) * D + r);
+        P.x_out[idx] = P.x_in[idx] + (y + sgv[t] * __ldcg(P.shout + idx));
+    }
+    __syncthreads();
+}
+
+} // namespace moe
+
+// ================= gated delta net half =================
+namespace gdn {
+using namespace mt;
+
+constexpr int D = 2048;
+constexpr int HK = 16, HV = 32, SD = 128, QKV = 2 * HK * SD + HV * SD, VD = HV * SD;
+constexpr int Q8_ROW_D = D / 32 * 34, Q8_ROW_V = VD / 32 * 34, HALF = 1088;
+constexpr int XS = D + D / 16;                         // padded fp16 row (also one K half of ssm_out's input)
+
+struct Layer {
+    const float * norm; const uint8_t * qkv; const uint8_t * z; const float * alpha; const float * beta;
+    const float * dt; const float * a; const float * conv; const float * snorm; const uint8_t * out;
+};
+struct Params {
+    Layer L;
+    const float * x_in; float * x_out;
+    float eps_norm, eps_l2, scale_l2, eps_gn;
+    int KS;                                 // snapshot slots (n_rs_seq + 1)
+    const float * cs_base; const int32_t * cs_ids; int64_t cs_row; // conv state [QKV][3] read from row cs_ids[0]
+    const float * ss_base; const int32_t * ss_ids; int64_t ss_row; // recurrent state [HV][SD][SD], row ss_ids[0]
+    float * cs_snap; int64_t cs_slot;       // snapshot slot s at cs_snap + s * cs_slot
+    float * ss_snap; int64_t ss_slot;
+    float * qkvc; float * zv; float * gb; float * o; float * y;
+    unsigned * bar; unsigned base;
+};
+
+template <int T>
+__global__ void __launch_bounds__(NT, 1) gdn_t_kernel(const Params P) {
+    __shared__ __align__(16) __half xs16[TM * XS];     // G0-G1: normed x; G3: gated-normed half of o
+    __shared__ __align__(16) uint8_t stage[NW][HALF];
+    const Layer & W = P.L;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int gw = warp * gridDim.x + blockIdx.x, nwg = NW * gridDim.x;
+    unsigned target = P.base;
+    const float * cs_in = P.cs_base + (int64_t) P.cs_ids[0] * P.cs_row;
+    const float * ss_in = P.ss_base + (int64_t) P.ss_ids[0] * P.ss_row;
+
+    norm_T<D, XS>(P.x_in, W.norm, P.eps_norm, T, xs16, nullptr);
+
+    // ---- G1: alpha / beta rows (f32), then qkv + z rows (q8_0 stream) ----
+    constexpr int NAB = 2 * HV, N1 = NAB + QKV + VD;
+    if (gw < NAB) {
+        const int h = gw % HV;
+        const float * w = (gw < HV ? W.alpha : W.beta) + (size_t) h * D;
+        float acc[TM];
+#pragma unroll
+        for (int t = 0; t < TM; t++) acc[t] = 0.f;
+#pragma unroll 4
+        for (int i = 0; i < D / 128; i++) {
+            const float4 v = __ldg((const float4 *) (w + 128 * i) + lane);
+#pragma unroll
+            for (int t = 0; t < TM; t++) if (t < T) acc[t] += dot4(v, ld4h(xs16 + t * XS + px(128 * i + 4 * lane)));
+        }
+#pragma unroll
+        for (int t = 0; t < TM; t++) {
+            const float a = wsum(acc[t]);
+            if (lane == 0 && t < T) {
+                if (gw < HV) { const float xb = a + __ldg(W.dt + h); P.gb[(t * 2 + 0) * HV + h] = (xb > 20.f ? xb : logf(1.f + expf(xb))) * __ldg(W.a + h); }
+                else P.gb[(t * 2 + 1) * HV + h] = 1.f / (1.f + expf(-a));
+            }
+        }
+    }
+    {
+        const int u0 = gw < NAB ? gw + nwg : gw;
+        const int nt = u0 < N1 ? 2 * ((N1 - u0 + nwg - 1) / nwg) : 0;
+        auto rowp = [&](int u) { const int r = u - NAB; return r < QKV ? W.qkv + (size_t) r * Q8_ROW_D : W.z + (size_t) (r - QKV) * Q8_ROW_D; };
+        auto ld = [&](int c, int4 * bb) {
+            const int4 * p = (const int4 *) (rowp(u0 + (c >> 1) * nwg) + (c & 1) * HALF);
+            bb[0] = __ldg(p + lane); bb[1] = __ldg(p + 32 + lane); if (lane < 4) bb[2] = __ldg(p + 64 + lane);
+        };
+        int4 b0[3], b1[3];
+        if (nt > 0) ld(0, b0);
+        if (nt > 1) ld(1, b1);
+        float acc[TM];
+#pragma unroll
+        for (int t = 0; t < TM; t++) acc[t] = 0.f;
+        float cw[4] = {0, 0, 0, 0}, cs[3] = {0, 0, 0};
+        for (int c = 0; c < nt; c++) {
+            const int r = u0 + (c >> 1) * nwg - NAB;
+            if ((c & 1) == 0 && r < QKV) { // epilogue inputs issued at row start (same address in all lanes: one load)
+                const float4 w4 = __ldg((const float4 *) (W.conv + 4 * r));
+                cw[0] = w4.x; cw[1] = w4.y; cw[2] = w4.z; cw[3] = w4.w;
+                cs[0] = cs_in[3 * r]; cs[1] = cs_in[3 * r + 1]; cs[2] = cs_in[3 * r + 2];
+            }
+            int4 * st = (int4 *) stage[warp];
+            st[lane] = b0[0]; st[32 + lane] = b0[1]; if (lane < 4) st[64 + lane] = b0[2];
+            __syncwarp();
+            b0[0] = b1[0]; b0[1] = b1[1]; b0[2] = b1[2];
+            if (c + 2 < nt) ld(c + 2, b1);
+            dot_q8h<T>(stage[warp], lane, 32 * (c & 1) + lane, xs16, XS, acc);
+            __syncwarp();
+            if (c & 1) {
+                float a[TM];
+#pragma unroll
+                for (int t = 0; t < TM; t++) { a[t] = wsum(acc[t]); acc[t] = 0.f; }
+                if (r < QKV) {
+                    // conv window in = [s0 s1 s2 a0 .. aT-1] spread over lanes (lane q holds in[q]), then
+                    // lane t < T computes token t's conv output and lanes 0..3*KS-1 write one snapshot value each
+                    float my = 0.f;
+#pragma unroll
+                    for (int q = 0; q < 3; q++) if (lane == q) my = cs[q];
+#pragma unroll
+                    for (int t = 0; t < TM; t++) if (lane == 3 + t) my = a[t];
+                    const float i0 = __shfl_sync(0xffffffff, my, lane), i1 = __shfl_sync(0xffffffff, my, lane + 1);
+                    const float i2 = __shfl_sync(0xffffffff, my, lane + 2), i3 = __shfl_sync(0xffffffff, my, lane + 3);
+                    if (lane < T) P.qkvc[(size_t) lane * QKV + r] = silu(cw[0] * i0 + cw[1] * i1 + cw[2] * i2 + cw[3] * i3);
+                    const int slot = lane / 3, m = lane % 3;              // slot = KS - j, window start max(0, T - slot)
+                    const float sv = __shfl_sync(0xffffffff, my, max(0, T - slot) + m);
+                    if (lane < 3 * P.KS) P.cs_snap[slot * P.cs_slot + 3 * r + m] = sv;
+                } else if (lane == 0) {
+#pragma unroll
+                    for (int t = 0; t < TM; t++) if (t < T) P.zv[(size_t) t * VD + r - QKV] = a[t];
+                }
+            }
+        }
+    }
+    tsync(P.bar, target);
+
+    // ---- G2: recurrence over the T tokens per (v head, column); lane holds state rows i = lane + 32 r ----
+    for (int u = gw; u < HV * SD; u += nwg) {
+        const int h = u / SD, col = u % SD, kh = h % HK;
+        const size_t off = (size_t) h * SD * SD + (size_t) col * SD;
+        float s[4];
+#pragma unroll
+        for (int r = 0; r < 4; r++) s[r] = ss_in[off + 32 * r + lane];
+        // all tokens' inputs issued up front (a load-use chain per token would pay T L2 round trips)
+        float q[TM][4], k[TM][4], vv[TM], gg[TM], be[TM];
+#pragma unroll
+        for (int t = 0; t < TM; t++) {
+            if (t < T) {
+#pragma unroll
+                for (int r = 0; r < 4; r++) {
+                    q[t][r] = __ldcg(P.qkvc + (size_t) t * QKV + kh * SD + 32 * r + lane);
+                    k[t][r] = __ldcg(P.qkvc + (size_t) t * QKV + HK * SD + kh * SD + 32 * r + lane);
+                }
+                vv[t] = __ldcg(P.qkvc + (size_t) t * QKV + 2 * HK * SD + h * SD + col);
+                gg[t] = __ldcg(P.gb + (t * 2 + 0) * HV + h);
+                be[t] = __ldcg(P.gb + (t * 2 + 1) * HV + h);
+            }
+        }
+#pragma unroll
+        for (int t = 0; t < TM; t++) {
+            if (t < T) {
+                const float iq = rsqrtf(wsum(q[t][0] * q[t][0] + q[t][1] * q[t][1] + q[t][2] * q[t][2] + q[t][3] * q[t][3]) / SD + P.eps_l2) * P.scale_l2;
+                const float ik = rsqrtf(wsum(k[t][0] * k[t][0] + k[t][1] * k[t][1] + k[t][2] * k[t][2] + k[t][3] * k[t][3]) / SD + P.eps_l2) * P.scale_l2;
+                const float g = expf(gg[t]);
+                float kv = 0.f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) kv += s[r] * k[t][r] * ik;
+                kv = wsum(kv);
+                const float delta = (vv[t] - g * kv) * be[t];
+                float at = 0.f;
+#pragma unroll
+                for (int r = 0; r < 4; r++) { s[r] = g * s[r] + k[t][r] * ik * delta; at += s[r] * q[t][r] * iq; }
+                at = wsum(at);
+                if (lane == 0) P.o[(size_t) t * VD + h * SD + col] = at * rsqrtf((float) SD);
+                const int slot = T - 1 - t;
+                if (slot < P.KS) {
+#pragma unroll
+                    for (int r = 0; r < 4; r++) P.ss_snap[slot * P.ss_slot + off + 32 * r + lane] = s[r];
+                }
+            }
+        }
+    }
+    tsync(P.bar, target);
+
+    // ---- G3: blocks split into two K halves; gated norm of the half's 16 heads per token, then ssm_out rows ----
+    {
+        const int half = blockIdx.x & 1, nbh = gridDim.x >> 1, bh = blockIdx.x >> 1;
+        __half * on16 = xs16; // [TM][XS], element e of the half = head (16 * half + e / 128), lane i = e % 128
+        for (int p = warp; p < T * 16; p += NW) {
+            const int t = p / 16, h = 16 * half + p % 16;
+            float v[4], z[4], ssq = 0.f;
+#pragma unroll
+            for (int r = 0; r < 4; r++) {
+                v[r] = __ldcg(P.o + (size_t) t * VD + h * SD + 32 * r + lane);
+                z[r] = __ldcg(P.zv + (size_t) t * VD + h * SD + 32 * r + lane);
+                ssq += v[r] * v[r];
+            }
+            const float inv = rsqrtf(wsum(ssq) / SD + P.eps_gn);
+#pragma unroll
+            for (int r = 0; r < 4; r++) {
+                const int i = 32 * r + lane;
+                on16[t * XS + pp((p % 16) * SD + i)] = __float2half(v[r] * inv * __ldg(W.snorm + i) * silu(z[r]));
+            }
+        }
+        __syncthreads();
+        const int gwh = warp * nbh + bh, nwh = NW * nbh;
+        const int nt = gwh < D ? 2 * ((D - gwh + nwh - 1) / nwh) : 0;
+        auto ld = [&](int c, int4 * bb) {
+            const int4 * p = (const int4 *) (W.out + (size_t) (gwh + (c >> 1) * nwh) * Q8_ROW_V + half * 2 * HALF + (c & 1) * HALF);
+            bb[0] = __ldg(p + lane); bb[1] = __ldg(p + 32 + lane); if (lane < 4) bb[2] = __ldg(p + 64 + lane);
+        };
+        int4 b0[3], b1[3];
+        if (nt > 0) ld(0, b0);
+        if (nt > 1) ld(1, b1);
+        float acc[TM];
+#pragma unroll
+        for (int t = 0; t < TM; t++) acc[t] = 0.f;
+        for (int c = 0; c < nt; c++) {
+            int4 * st = (int4 *) stage[warp];
+            st[lane] = b0[0]; st[32 + lane] = b0[1]; if (lane < 4) st[64 + lane] = b0[2];
+            __syncwarp();
+            b0[0] = b1[0]; b0[1] = b1[1]; b0[2] = b1[2];
+            if (c + 2 < nt) ld(c + 2, b1);
+            dot_q8h<T>(stage[warp], lane, 32 * (c & 1) + lane, on16, XS, acc);
+            __syncwarp();
+            if (c & 1) {
+                const int r = gwh + (c >> 1) * nwh;
+#pragma unroll
+                for (int t = 0; t < TM; t++) { const float a = wsum(acc[t]); acc[t] = 0.f; if (lane == 0 && t < T) P.y[((size_t) half * TM + t) * D + r] = a; }
+            }
+        }
+    }
+    tsync(P.bar, target);
+    // ---- G4: combine ----
+    for (int i = blockIdx.x * NT + threadIdx.x; i < T * D; i += gridDim.x * NT) {
+        const int t = i / D, r = i % D;
+        P.x_out[i] = P.x_in[i] + (__ldcg(P.y + (size_t) t * D + r) + __ldcg(P.y + ((size_t) TM + t) * D + r));
+    }
+}
+
+} // namespace gdn
+
+
+unsigned * mega_bar(ggml_backend_cuda_context & ctx) {
+    if (ctx.p60_mega_bar == nullptr) {
+        CUDA_CHECK(cudaMalloc(&ctx.p60_mega_bar, sizeof(unsigned)));
+        CUDA_CHECK(cudaMemset(ctx.p60_mega_bar, 0, sizeof(unsigned)));
+        ctx.p60_mega_epoch = 0;
+    }
+    return ctx.p60_mega_bar;
+}
+
+template <typename KP>
+void mega_launch(ggml_backend_cuda_context & ctx, const void * kernel, KP & kp, int n_barriers) {
+    const int nblk = ggml_cuda_info().devices[ctx.device].nsm;
+    kp.bar  = mega_bar(ctx);
+    kp.base = ctx.p60_mega_epoch;
+    void * args[] = { &kp };
+    CUDA_CHECK(cudaLaunchCooperativeKernel(kernel, dim3(nblk), dim3(mt::NT), args, 0, ctx.stream()));
+    ctx.p60_mega_epoch += (unsigned) (n_barriers * nblk);
+}
+
+} // namespace
+
+void ggml_cuda_p60_mega_moe_t(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_moe_args & args, int n_tokens) {
+    using namespace moe;
+    GGML_ASSERT(n_tokens >= 1 && n_tokens <= TM);
+    const size_t n_logits = (TM * (NE + 1) + 3) & ~3, // float4 alignment of what follows
+                  n_shgu = TM * 2 * FF, n_egu = (size_t) MAXU * TM * 2 * FF, n_shout = TM * D;
+    ggml_cuda_pool_alloc<float> scratch(ctx.pool(), n_logits + n_shgu + n_egu + n_shout + (size_t) TM * NU * D);
+    Params kp = {};
+    kp.L = { args.norm, args.router, args.sgate, (const uint8_t *) args.gate, (const uint8_t *) args.up, (const uint8_t *) args.down,
+             (const uint8_t *) args.sg, (const uint8_t *) args.su, (const uint8_t *) args.sd };
+    kp.x_in   = args.x_in;
+    kp.x_out  = args.x_out;
+    kp.eps    = args.eps;
+    kp.logits = scratch.get();
+    kp.shgu   = kp.logits + n_logits;
+    kp.egu    = kp.shgu + n_shgu;
+    kp.shout  = kp.egu + n_egu;
+    kp.ypart  = kp.shout + n_shout;
+    static const void * const kern[TM] = { (const void *) moe_t_kernel<1>, (const void *) moe_t_kernel<2>, (const void *) moe_t_kernel<3>,
+                                           (const void *) moe_t_kernel<4>, (const void *) moe_t_kernel<5>, (const void *) moe_t_kernel<6> };
+    mega_launch(ctx, kern[n_tokens - 1], kp, 3);
+}
+
+void ggml_cuda_p60_mega_gdn_t(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_gdn_args & args, int n_tokens, int n_snap,
+        int64_t cs_slot, int64_t ss_slot) {
+    using namespace gdn;
+    GGML_ASSERT(n_tokens >= 1 && n_tokens <= TM && n_snap >= 1 && n_snap <= TM);
+    const size_t n_qkvc = (size_t) TM * QKV, n_zv = (size_t) TM * VD, n_gb = TM * 2 * HV, n_o = (size_t) TM * VD;
+    ggml_cuda_pool_alloc<float> scratch(ctx.pool(), n_qkvc + n_zv + n_gb + n_o + 2 * TM * D);
+    Params kp = {};
+    kp.L = { args.attn_norm, (const uint8_t *) args.qkv, (const uint8_t *) args.z, args.alpha, args.beta, args.dt, args.a, args.conv,
+             args.snorm, (const uint8_t *) args.out };
+    kp.x_in     = args.x_in;
+    kp.x_out    = args.x_out;
+    kp.eps_norm = args.eps_norm;
+    kp.eps_l2   = args.eps_l2;
+    kp.scale_l2 = args.scale_l2;
+    kp.eps_gn   = args.eps_gn;
+    kp.KS       = n_snap;
+    kp.cs_base  = args.cs_base; kp.cs_ids = args.cs_ids; kp.cs_row = args.cs_row;
+    kp.ss_base  = args.ss_base; kp.ss_ids = args.ss_ids; kp.ss_row = args.ss_row;
+    kp.cs_snap  = args.cs_out;  kp.cs_slot = cs_slot;
+    kp.ss_snap  = args.ss_out;  kp.ss_slot = ss_slot;
+    kp.qkvc = scratch.get();
+    kp.zv   = kp.qkvc + n_qkvc;
+    kp.gb   = kp.zv + n_zv;
+    kp.o    = kp.gb + n_gb;
+    kp.y    = kp.o + n_o;
+    static const void * const kern[TM] = { (const void *) gdn_t_kernel<1>, (const void *) gdn_t_kernel<2>, (const void *) gdn_t_kernel<3>,
+                                           (const void *) gdn_t_kernel<4>, (const void *) gdn_t_kernel<5>, (const void *) gdn_t_kernel<6> };
+    mega_launch(ctx, kern[n_tokens - 1], kp, 3);
+}
