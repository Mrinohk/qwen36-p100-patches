+#pragma unroll
+                for (int i = 0; i < 4; i++) {
+                    const float g[4] = {g4[i].x, g4[i].y, g4[i].z, g4[i].w}, u_[4] = {u4[i].x, u4[i].y, u4[i].z, u4[i].w};
