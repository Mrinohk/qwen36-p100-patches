+        for (int t = 0; t < T; t++)
+#pragma unroll
+            for (int k = 0; k < NU; k++) um |= (sel[t][k] == (int) threadIdx.x) ? 1u << t : 0u;
+        ub = __ballot_sync(0xffffffff, um != 0);
