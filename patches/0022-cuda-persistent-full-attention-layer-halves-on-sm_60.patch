+
+// full-attention half: attn_norm ... attn_residual, 1..6 tokens (p60-fa.cu)
+static int p60_try_mega_attn(ggml_backend_cuda_context * ctx, ggml_cgraph * g, int i, bool dry = false) {
+    const ggml_tensor * norm = g->nodes[i];
+    const ggml_tensor * cur_t = nullptr;
+    if (i + 2 >= g->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * nmul = g->nodes[i + 1];
+    if (nmul->op != GGML_OP_MUL || nmul->src[0] != norm || nmul->src[1] == nullptr) {
+        return 0;
+    }
+    int il = -1;
+    if (sscanf(nmul->src[1]->name, "blk.%d.attn_norm.weight", &il) != 1 || !p60_is_weight(nmul->src[1], il, "attn_norm.weight")) {
+        return 0;
+    }
+    int e = -1;
+    for (int k = i + 2; k < g->n_nodes && k < i + 60; k++) {
+        if (g->nodes[k]->op == GGML_OP_ADD && p60_is_node(g->nodes[k], "attn_residual", il)) {
+            e = k;
+            break;
+        }
+    }
+    if (e < 0) {
+        return 0;
+    }
+    const ggml_tensor * qmm = nullptr, * kmm = nullptr, * vmm = nullptr, * omm = nullptr, * qn = nullptr, * kn = nullptr;
+    const ggml_tensor * qrope = nullptr, * krope = nullptr, * ksr = nullptr, * vsr = nullptr, * fa = nullptr, * gmul = nullptr;
+    float eps_q = -1.0f, eps_k = -1.0f;
+    for (int k = i + 2; k < e; k++) {
+        const ggml_tensor * t = g->nodes[k];
+        cur_t = t;
+        switch (t->op) {
+            case GGML_OP_RESHAPE: case GGML_OP_VIEW: case GGML_OP_TRANSPOSE: case GGML_OP_PERMUTE: case GGML_OP_NONE:
+            case GGML_OP_CONT:
+                break;
+            case GGML_OP_MUL_MAT:
+                if      (p60_is_weight(t->src[0], il, "attn_q.weight"))      { qmm = t; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "attn_k.weight"))      { kmm = t; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "attn_v.weight"))      { vmm = t; if (t->src[1] != nmul) P60_MEGA_FAIL; }
+                else if (p60_is_weight(t->src[0], il, "attn_output.weight")) { omm = t; }
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_RMS_NORM: {
+                // q / k head norms; identified by the MUL that follows
+                if (k + 1 >= e || g->nodes[k + 1]->op != GGML_OP_MUL || g->nodes[k + 1]->src[0] != t) P60_MEGA_FAIL;
+                float eps;
+                memcpy(&eps, t->op_params, sizeof(float));
+                const ggml_tensor * w = g->nodes[k + 1]->src[1];
+                if      (p60_is_weight(w, il, "attn_q_norm.weight")) eps_q = eps;
+                else if (p60_is_weight(w, il, "attn_k_norm.weight")) eps_k = eps;
+                else P60_MEGA_FAIL;
+                break;
+            }
+            case GGML_OP_MUL:
+                if      (p60_is_weight(t->src[1], il, "attn_q_norm.weight")) qn = t;
+                else if (p60_is_weight(t->src[1], il, "attn_k_norm.weight")) kn = t;
+                else if (t->src[1]->op == GGML_OP_UNARY && ggml_get_unary_op(t->src[1]) == GGML_UNARY_OP_SIGMOID) gmul = t;
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_ROPE:
+                if      (qn && t->src[0] == qn) qrope = t;
+                else if (kn && t->src[0] == kn) krope = t;
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_SET_ROWS:
+                if      (krope && p60_view_root(t->src[0]) == krope) ksr = t;
+                else if (vmm && p60_view_root(t->src[0]) == vmm)     vsr = t;
+                else P60_MEGA_FAIL;
+                break;
+            case GGML_OP_FLASH_ATTN_EXT:
+                fa = t;
+                break;
+            case GGML_OP_UNARY:
+                if (ggml_get_unary_op(t) != GGML_UNARY_OP_SIGMOID) P60_MEGA_FAIL;
+                break;
+            default:
+                P60_MEGA_FAIL;
+        }
+    }
+    const ggml_tensor * add = g->nodes[e];
+    const int64_t T = norm->src[0]->ne[1];
+    if (!qmm || !kmm || !vmm || !omm || !qn || !kn || !qrope || !krope || !ksr || !vsr || !fa || !gmul || eps_q < 0.0f || eps_k < 0.0f ||
+            T < 1 || T > 6 || add->src[1] != norm->src[0] || add->src[0] != omm || omm->src[1] != gmul) {
+        P60_MEGA_FAIL;
+    }
+    // rope: the same parameters for q and k, M-RoPE without offsets, frequency factors or YaRN extrapolation
+    const int32_t * rp = (const int32_t *) qrope->op_params;
+    float ext_factor;
+    memcpy(&ext_factor, rp + 7, sizeof(float));
+    const int mode = rp[2];
+    if (memcmp(qrope->op_params, krope->op_params, 16 * sizeof(int32_t)) != 0 || (mode != GGML_ROPE_TYPE_IMROPE && mode != GGML_ROPE_TYPE_MROPE) ||
+            rp[15] != 0 || ext_factor != 0.0f || qrope->src[2] != nullptr || krope->src[2] != nullptr || qrope->src[1] != krope->src[1] ||
+            qrope->src[1]->type != GGML_TYPE_I32 || ggml_nelements(qrope->src[1]) != 4*T || rp[1] <= 0 || rp[1] > 256 || rp[1] % 2 != 0 ||
+            qrope->ne[0] != 256 || qrope->ne[1] != 16 || qrope->ne[2] != T || krope->ne[0] != 256 || krope->ne[1] != 2 || krope->ne[2] != T ||
+            !ggml_is_contiguous(qrope) || !ggml_is_contiguous(krope)) {
+        P60_MEGA_FAIL;
+    }
+    // cache writes: f16 rows of 2 x 256, one i64 index per token
+    const ggml_tensor * kc = ksr->src[2] ? ksr->src[2] : p60_view_root(ksr), * vc = vsr->src[2] ? vsr->src[2] : p60_view_root(vsr);
+    if (ksr->type != GGML_TYPE_F16 || vsr->type != GGML_TYPE_F16 || ksr->ne[0] != 512 || vsr->ne[0] != 512 ||
+            ksr->src[1]->type != GGML_TYPE_I64 || vsr->src[1]->type != GGML_TYPE_I64 || ggml_nelements(ksr->src[1]) != T ||
+            ggml_nelements(vsr->src[1]) != T || !ggml_is_contiguous(ksr->src[1]) || !ggml_is_contiguous(vsr->src[1]) ||
+            ksr->src[0]->ne[0] != 512 || ksr->src[0]->ne[1] != T || vsr->src[0]->ne[0] != 512 || vsr->src[0]->ne[1] != T ||
+            ksr->nb[0] != 2 || vsr->nb[0] != 2 || ksr->nb[1] % 16 != 0 || vsr->nb[1] % 16 != 0) {
+        P60_MEGA_FAIL;
+    }
+    // flash attention over the same cache rows: K / V views [256, n_kv, 2], position stride = cache row
+    const ggml_tensor * Qf = fa->src[0], * Kf = fa->src[1], * Vf = fa->src[2], * mask = fa->src[3];
+    float scale, max_bias, softcap;
+    memcpy(&scale,    (const float *) fa->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const float *) fa->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const float *) fa->op_params + 2, sizeof(float));
+    if (p60_view_root(Qf) != qrope || Kf->type != GGML_TYPE_F16 || Vf->type != GGML_TYPE_F16 || mask == nullptr || mask->type != GGML_TYPE_F16 ||
+            fa->src[4] != nullptr || max_bias != 0.0f || softcap != 0.0f ||
+            Kf->data != ksr->data || Vf->data != vsr->data || p60_view_root(Kf) != p60_view_root(ksr) || p60_view_root(Vf) != p60_view_root(vsr) ||
+            Kf->ne[0] != 256 || Kf->ne[2] != 2 || Vf->ne[0] != 256 || Vf->ne[2] != 2 || Kf->ne[1] != Vf->ne[1] ||
+            Kf->nb[1] != ksr->nb[1] || Vf->nb[1] != vsr->nb[1] || Kf->nb[2] != 512 || Vf->nb[2] != 512 ||
+            mask->ne[0] < Kf->ne[1] || mask->ne[1] < T || mask->nb[0] != 2 || mask->ne[2] != 1 || mask->ne[3] != 1 ||
+            ((uintptr_t) Kf->data) % 16 != 0 || ((uintptr_t) Vf->data) % 16 != 0 || p60_view_root(gmul->src[0]) != fa) {
+        P60_MEGA_FAIL;
+    }
+    GGML_UNUSED(kc); GGML_UNUSED(vc);
+    if (!p60_mat(qmm->src[0], GGML_TYPE_Q8_0, 2048, 8192) || !p60_mat(kmm->src[0], GGML_TYPE_Q8_0, 2048, 512) ||
+            !p60_mat(vmm->src[0], GGML_TYPE_Q8_0, 2048, 512) || !p60_mat(omm->src[0], GGML_TYPE_Q8_0, 4096, 2048) ||
+            !p60_f32_vec(nmul->src[1], 2048) || !p60_f32_vec(qn->src[1], 256) || !p60_f32_vec(kn->src[1], 256) ||
+            !p60_f32_vec(norm->src[0], 2048*T) || !p60_f32_vec(add, 2048*T) || !p60_range_private(g, i, e, add)) {
+        P60_MEGA_FAIL;
+    }
+    if (dry) {
+        return e - i;
+    }
+    ggml_cuda_p60_mega_attn_args a = {};
+    a.x_in = (const float *) norm->src[0]->data; a.x_out = (float *) add->data;
+    a.attn_norm = (const float *) nmul->src[1]->data;
+    memcpy(&a.eps_norm, norm->op_params, sizeof(float));
+    a.wq = (const char *) qmm->src[0]->data; a.wk = (const char *) kmm->src[0]->data;
+    a.wv = (const char *) vmm->src[0]->data; a.wo = (const char *) omm->src[0]->data;
+    a.q_norm = (const float *) qn->src[1]->data; a.k_norm = (const float *) kn->src[1]->data;
+    a.eps_q = eps_q; a.eps_k = eps_k;
+    a.pos = (const int32_t *) qrope->src[1]->data;
+    a.n_dims = rp[1];
+    memcpy(a.sections, rp + 11, 4 * sizeof(int32_t));
+    a.imrope = mode == GGML_ROPE_TYPE_IMROPE;
+    memcpy(&a.freq_base,   rp + 5, sizeof(float));
+    memcpy(&a.freq_scale,  rp + 6, sizeof(float));
+    memcpy(&a.attn_factor, rp + 8, sizeof(float));
+    a.k_cache = (half *) ksr->data; a.k_row = ksr->nb[1] / 2; a.k_idx = (const int64_t *) ksr->src[1]->data;
+    a.v_cache = (half *) vsr->data; a.v_row = vsr->nb[1] / 2; a.v_idx = (const int64_t *) vsr->src[1]->data;
+    a.n_kv = (int) Kf->ne[1];
+    a.mask = (const half *) mask->data; a.mask_row = mask->nb[1] / 2;
+    a.scale = scale;
+    ggml_cuda_p60_mega_attn(*ctx, a, (int) T);
+    return e - i;
+}
