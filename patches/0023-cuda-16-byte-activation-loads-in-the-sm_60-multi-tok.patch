 #pragma unroll
-            for (int t = 0; t < TM; t++) if (t < T) acc[t] += dot4(v, ld4h(xs16 + t * XS + px(128 * i + 4 * lane)));
+            for (int t = 0; t < TM; t++) if (t < T) acc[t] += dot4(v, ld4h(xs16 + t * XS + px8(128 * i + 4 * lane)));
         }
         int t;
         const float a = wsum_multi<T>(acc, lane, t);
@@ -591,7 +591,7 @@ __global__ void __launch_bounds__(NT, 1) gdn_t_kernel(const Params P) {
 #pragma unroll
             for (int r = 0; r < 4; r++) {
                 const int i = 32 * r + lane;
-                on16[t * XS + pp((p % 16) * SD + i)] = __float2half(v[r] * inv * __ldg(W.snorm + i) * silu(z[r]));
+                on16[t * XS + pp8((p % 16) * SD + i)] = __float2half(v[r] * inv * __ldg(W.snorm + i) * silu(z[r]));
             }
         }
         __syncthreads();
@@ -640,7 +640,7 @@ __global__ void __launch_bounds__(NT, 1) gdn_t_kernel(const Params P) {
 namespace q8t {
 using namespace mt;
 
-constexpr int K = 2048, XS = K + K / 16, HALF = 1088;
+constexpr int K = 2048, XS = K + K / 8, HALF = 1088; // px8 layout
 
 template <int T>
 __global__ void __launch_bounds__(NT, 1) q8_0_t_kernel(const uint8_t * __restrict__ W, const int64_t nb01, const int nrows,
@@ -666,7 +666,7 @@ __global__ void __launch_bounds__(NT, 1) q8_0_t_kernel(const uint8_t * __restric
         for (int i = 0; i < 16; i++) {
             const float v[4] = {xv[i].x, xv[i].y, xv[i].z, xv[i].w};
 #pragma unroll
-            for (int c = 0; c < 4; c++) xs16[t * XS + pp(k0 + 4 * i + c)] = __float2half(v[c] * sc);
+            for (int c = 0; c < 4; c++) xs16[t * XS + pp8(k0 + 4 * i + c)] = __float2half(v[c] * sc);
         }
