From d08e41217114a61b78d039498bd36f62016d1f51 Mon Sep 17 00:00:00 2001
From: Mrinohk <5554998+Mrinohk@users.noreply.github.com>
Date: Mon, 12 Oct 2026 12:16:32 -0400
Subject: [PATCH 23/31] cuda : 16-byte activation loads in the sm_60
 multi-token q8_0 dots

The fp16 activation rows of the GDN, attention and output-layer kernels get 8 halves of padding per 64 elements
instead of 4 (px8 / pp8), so every 32-element block starts 16 B aligned and dot_q8h reads x with 4 uint4 loads per
token and block instead of 8 uint2 ones; the 8 lanes of a 128-bit load phase still hit disjoint bank quads. Same
products in the same order: output unchanged (wikitext PPL identical to the last digit). The MoE kernel keeps its
layout (it is at the 48 KB shared-memory limit).

Output layer at 6 tokens: 1529 -> 1510 us; MTP prod sampler, 8 prompts x 256: 171.0 -> 171.8 t/s.

Assisted-by: Claude Opus 5.5
---
 ggml/src/ggml-cuda/p60-fa.cu     |  4 ++--
 ggml/src/ggml-cuda/p60-mega-t.cu | 10 +++++-----
 ggml/src/ggml-cuda/p60-mt.cuh    | 24 ++++++++++++++++--------
 3 files changed, 23 insertions(+), 15 deletions(-)

diff --git a/ggml/src/ggml-cuda/p60-fa.cu b/ggml/src/ggml-cuda/p60-fa.cu
index 53fb66703..2ed32b31b 100644
--- a/ggml/src/ggml-cuda/p60-fa.cu
+++ b/ggml/src/ggml-cuda/p60-fa.cu
@@ -263,7 +263,7 @@ namespace at {
 using namespace p60mt;
 
 constexpr int D = 2048, NQ = 16, NKV = 2, HD = 256, QF = NQ * 2 * HD, KVN = NKV * HD, O = NQ * HD;
-constexpr int XS = D + D / 16, HALF = 1088, Q8_ROW_D = D / 32 * 34, Q8_ROW_O = O / 32 * 34;
+constexpr int XS = D + D / 8, HALF = 1088, Q8_ROW_D = D / 32 * 34, Q8_ROW_O = O / 32 * 34;
 constexpr int NROW1 = QF + 2 * KVN; // q (+gate), k, v rows
 
 struct PreParams {
@@ -460,7 +460,7 @@ __global__ void __launch_bounds__(NT, 1) attn_post_kernel(const PostParams P) {
             for (int i = 0; i < 16; i++) {
                 const float vv[4] = {xv[i].x, xv[i].y, xv[i].z, xv[i].w};
 #pragma unroll
-                for (int c = 0; c < 4; c++) xs16[t * XS + pp(64 * lane + 4 * i + c)] = __float2half(vv[c]);
+                for (int c = 0; c < 4; c++) xs16[t * XS + pp8(64 * lane + 4 * i + c)] = __float2half(vv[c]);
             }
         }
         __syncthreads();
