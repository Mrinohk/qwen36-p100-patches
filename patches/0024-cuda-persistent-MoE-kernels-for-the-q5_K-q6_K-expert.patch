+        } else {
+            auto q6b = [&](int g) { return W.down + ((size_t) ulist[g / D] * D + g % D + ri) * Q6K_ROW + sb * 210; };
+            for (int g0 = r0 + 4 * warp; g0 < r1; g0 += 4 * NW) {
