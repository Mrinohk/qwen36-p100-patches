+// Exact persistent kernels (GGML_CUDA_P60_MEGAX=1, generation steps tagged by GGML_CUDA_P60_EXACT): every token gives
+// bit-identical results to the stock single-token kernels. Each warp emulates the thread layout and reduction order of
+// the stock kernel it replaces (mul_mat_vec_q with 4 warps, mul_mat_vec_f with 8 warps, rms_norm_f32<1024>,
+// quantize_q8_1, topk_moe_cuda<256>, moe_weighted_reduction_f32), and the float expressions are copied from them.
+
+namespace {
+
+constexpr int NT = 512, NW = NT / 32;
+constexpr int D = 2048, NE = 256, NU = 8, FF = 512, TMAX = 6;
+
+__device__ __forceinline__ void grid_sync(unsigned * bar, unsigned & target) {
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        target += gridDim.x;
+        __threadfence();
+        atomicAdd(bar, 1u);
+        while ((int) (*(volatile unsigned *) bar - target) < 0) {}
+        __threadfence();
+    }
+    __syncthreads();
+}
+
+// the parts of mmvq.cu's tables for the types used here
+template <ggml_type type> struct mmvq_x;
+template <> struct mmvq_x<GGML_TYPE_Q8_0> { static constexpr int vdr = VDR_Q8_0_Q8_1_MMVQ; static constexpr int bs = 34;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) { return vec_dot_q8_0_q8_1(vbq, bq8_1, kbx, iqs); } };
+template <> struct mmvq_x<GGML_TYPE_Q4_K> { static constexpr int vdr = VDR_Q4_K_Q8_1_MMVQ; static constexpr int bs = 144;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) { return vec_dot_q4_K_q8_1(vbq, bq8_1, kbx, iqs); } };
+template <> struct mmvq_x<GGML_TYPE_Q5_K> { static constexpr int vdr = VDR_Q5_K_Q8_1_MMVQ; static constexpr int bs = 176;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) { return vec_dot_q5_K_q8_1(vbq, bq8_1, kbx, iqs); } };
+template <> struct mmvq_x<GGML_TYPE_Q6_K> { static constexpr int vdr = VDR_Q6_K_Q8_1_MMVQ; static constexpr int bs = 210;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) { return vec_dot_q6_K_q8_1(vbq, bq8_1, kbx, iqs); } };
+
+// mul_mat_vec_q, ncols_dst = 1, 4 warps: one output row from one warp. Lane l plays thread l of each of the 4 warps.
+template <ggml_type type>
+__device__ __forceinline__ float mmvq_row(const void * row, const block_q8_1 * y, const int ncols_x, const int lane) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = mmvq_x<type>::vdr;
+    constexpr int nwarps = 4;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps*WARP_SIZE / qi;
+    float part[nwarps];
+#pragma unroll
+    for (int w = 0; w < nwarps; w++) {
+        const int tid = WARP_SIZE*w + lane;
+        float tmp = 0.0f;
+        for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (qk/QK8_1);
+            const int kqs = vdr * (tid % (qi/vdr));
+            tmp += mmvq_x<type>::f(row, &y[kby], kbx, kqs);
+        }
+        part[w] = tmp;
+    }
+    float tmp = part[0];
+#pragma unroll
+    for (int l = 0; l < nwarps-1; ++l) {
+        tmp += part[l + 1];
+    }
+    return warp_reduce_sum<WARP_SIZE>(tmp);
+}
+
+// mul_mat_vec_f<float, float, ncols_dst = 1, block_size = 256>, K = 2048: one output row from one warp
+__device__ __forceinline__ float mmvf_row(const float * x, const float * y, const int lane) {
+    constexpr int block_size = 256, ncols2 = D / 2;
+    const float2 * x2 = (const float2 *) x;
+    const float2 * y2 = (const float2 *) y;
+    float ws[block_size / WARP_SIZE];
+#pragma unroll
+    for (int w = 0; w < block_size / WARP_SIZE; w++) {
+        const int tid = WARP_SIZE*w + lane;
+        float sumf = 0.0f;
+        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            const float2 tmpx = x2[col2];
+            const float2 tmpy = __ldcg(y2 + col2);
+            ggml_cuda_mad(sumf, tmpx.x, tmpy.x);
+            ggml_cuda_mad(sumf, tmpx.y, tmpy.y);
+        }
+        ws[w] = warp_reduce_sum<WARP_SIZE>(sumf);
+    }
+    float sumf = 0.0f;
+#pragma unroll
+    for (int w = 0; w < block_size / WARP_SIZE; w++) {
+        if (lane == w) {
+            sumf = ws[w];
+        }
+    }
+    return warp_reduce_sum<WARP_SIZE>(sumf);
+}
+
+// rms_norm_f32<1024, do_multiply> on one 2048 row, by one block of 512 threads (each plays threads tid and tid + 512)
+__device__ __forceinline__ void rms_norm_row(const float * x, const float * mul, float * dst, const float eps, float * s_sum) {
+    constexpr int block_size = 1024, max_cache = 4, ncols = D;
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE;
+    float tmp[2], xv[2][max_cache];
+#pragma unroll
+    for (int h = 0; h < 2; h++) {
+        const int tid = threadIdx.x + h*NT;
+        tmp[h] = 0.0f;
+#pragma unroll
+        for (int k = 0; k < max_cache; ++k) {
+            const int col  = tid + k*block_size;
+            const float xi = col < ncols ? x[col] : 0.0f;
+            xv[h][k] = xi;
+            tmp[h]  += xi * xi;
+        }
+        tmp[h] = warp_reduce_sum<WARP_SIZE>(tmp[h]);
+    }
+    if (lane == 0) {
+        s_sum[warp]      = tmp[0];
+        s_sum[warp + NW] = tmp[1];
+    }
+    __syncthreads();
+    float t = s_sum[lane];
+    t = warp_reduce_sum<WARP_SIZE>(t);
+    const float mean = t / ncols;
+    const float scale = rsqrtf(mean + eps);
+#pragma unroll
+    for (int h = 0; h < 2; h++) {
+        const int tid = threadIdx.x + h*NT;
+#pragma unroll
+        for (int k = 0; k < max_cache; ++k) {
+            const int col = tid + k*block_size;
+            if (col < ncols) {
+                dst[col] = scale * xv[h][k] * mul[col];
+            }
+        }
+    }
+    __syncthreads();
+}
+
+// quantize_q8_1 of one 32-value block by one warp (lane = value)
+__device__ __forceinline__ void quantize_block(const float xi, block_q8_1 * yb, const int lane) {
+    float amax = fabsf(xi);
+    float sum = xi;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    yb->qs[lane] = q;
+    if (lane == 0) {
+        yb->ds = make_half2(d, sum);
+    }
+}
+
+// topk_moe_cuda<256, false> with softmax, with_norm, scale 1: one warp, one token
+__device__ __forceinline__ void topk_moe_warp(const float * logits, int * ids, float * weights, const float clamp_val, const int lane) {
+    constexpr int n_experts = NE, n_expert_used = NU;
+    constexpr int experts_per_thread = n_experts / WARP_SIZE;
+    float wt[experts_per_thread];
+#pragma unroll
+    for (int i = 0; i < n_experts; i += WARP_SIZE) {
+        wt[i / WARP_SIZE] = __ldcg(logits + i + lane);
+    }
+    {   // softmax_warp_inplace<experts_per_thread, false>
+        float max_val = -INFINITY;
+#pragma unroll
+        for (int i = 0; i < experts_per_thread; i++) {
+            max_val = max(max_val, wt[i]);
+        }
+        max_val = warp_reduce_max(max_val);
+        float sum = 0.f;
+#pragma unroll
+        for (int i = 0; i < experts_per_thread; i++) {
+            const float val = expf(wt[i] - max_val);
+            wt[i]           = val;
+            sum += val;
+        }
+        sum = warp_reduce_sum(sum);
+        const float inv_sum = 1.0f / sum;
+#pragma unroll
+        for (int i = 0; i < experts_per_thread; i++) {
+            wt[i] *= inv_sum;
+        }
+    }
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; i++) {
+        if (__isnanf(wt[i])) {
+            wt[i] = -FLT_MAX;
+        }
+    }
+    float wt_sum = 0.f;
+    float output_weights[experts_per_thread];
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; i++) {
+        output_weights[i] = 0.f;
+    }
+    for (int k = 0; k < n_expert_used; k++) {
+        float max_val    = wt[0];
+        int   max_expert = lane;
+#pragma unroll
+        for (int i = 1; i < experts_per_thread; i++) {
+            const int expert = lane + i * WARP_SIZE;
+            if (wt[i] > max_val) {
+                max_val    = wt[i];
+                max_expert = expert;
+            }
+        }
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask /= 2) {
+            const float val    = __shfl_xor_sync(0xFFFFFFFF, max_val, mask, WARP_SIZE);
+            const int   expert = __shfl_xor_sync(0xFFFFFFFF, max_expert, mask, WARP_SIZE);
+            if (val > max_val || (val == max_val && expert < max_expert)) {
+                max_val    = val;
+                max_expert = expert;
+            }
+        }
+        if ((max_expert & (WARP_SIZE - 1)) == lane) {
+            wt[max_expert / WARP_SIZE] = -INFINITY;
+        }
+        if ((k & (WARP_SIZE - 1)) == lane) {
+            output_weights[k / WARP_SIZE] = max_val;
+        }
+        if ((max_expert & (WARP_SIZE - 1)) == lane) {
+            ids[k] = max_expert;
+            wt_sum += max_val;
+        }
+    }
+    wt_sum              = warp_reduce_sum(wt_sum);
+    wt_sum              = max(wt_sum, clamp_val);
+    const float inv_sum = 1.0f / wt_sum;
+#pragma unroll
+    for (int i = 0; i < experts_per_thread; i++) {
+        output_weights[i] *= inv_sum;
+    }
+    const float scale_val = 1.0f;
+    if (lane < n_expert_used) {
+        weights[lane] = output_weights[0] * scale_val;
+    }
+}
+
+__device__ __forceinline__ float silu_x(float x) {
+    return ggml_cuda_op_silu_single(x);
+}
+
+template <ggml_type type>
+__device__ __forceinline__ size_t row_bytes(int ncols) {
+    return (size_t) (ncols / ggml_cuda_type_traits<type>::qk) * mmvq_x<type>::bs;
+}
+
+struct moe_x_params {
+    ggml_cuda_p60_mega_moe_args a;
+    int T;
+    float * xn;          // [T][D] normed input (f32)
+    block_q8_1 * yq;     // [T][D/32] normed input (q8_1)
+    float * logits;      // [T][NE]
+    float * sgl;         // [T] shared expert gate logit
+    float * shgu;        // [T][2][FF] shared gate | up
+    float * egu;         // [T][NU][2][FF] expert gate | up
+    block_q8_1 * eact;   // [T][NU][FF/32] expert swiglu (q8_1)
+    float * shd;         // [T][D] shared expert down
+    float * dbg;         // [T][NU+2][D] debug: expert down per slot, moe sum, gated shared expert (or nullptr)
+    unsigned * bar;
+    unsigned base;
+};
+
+template <ggml_type tg, ggml_type td>
+__global__ void __launch_bounds__(NT, 1) p60_mega_moe_x_kernel(const moe_x_params P) {
+    __shared__ float s_sum[2*NW];
+    __shared__ int   sel[TMAX][NU];
+    __shared__ float selw[TMAX][NU];
+    __shared__ float sig[TMAX];
+    __shared__ block_q8_1 shact[TMAX][FF/QK8_1];
+    const ggml_cuda_p60_mega_moe_args & A = P.a;
+    const int T = P.T;
+    const int lane = threadIdx.x % WARP_SIZE, warp = threadIdx.x / WARP_SIZE;
+    const int gw = warp * gridDim.x + blockIdx.x, nwg = NW * gridDim.x;
+    unsigned target = P.base;
+
+    // phase 0: rms_norm * w per token (block t), then quantize_q8_1
+    if ((int) blockIdx.x < T) {
+        const int t = blockIdx.x;
+        rms_norm_row(A.x_in + t*D, A.norm, P.xn + t*D, A.eps, s_sum);
+        for (int b = warp; b < D/QK8_1; b += NW) {
+            quantize_block(__ldcg(P.xn + t*D + b*QK8_1 + lane), P.yq + t*(D/QK8_1) + b, lane);
+        }
+    }
+    grid_sync(P.bar, target);
+
+    // phase 1: router, shared expert gate logit (f32), shared gate / up (q8_0)
+    {
+        const int n_r = T*NE, n_s = T, n_gu = T*2*FF;
+        for (int u = gw; u < n_r + n_s + n_gu; u += nwg) {
+            if (u < n_r) {
+                const int t = u / NE, r = u % NE;
+                const float v = mmvf_row(A.router + (size_t) r*D, P.xn + t*D, lane);
+                if (lane == 0) P.logits[t*NE + r] = v;
+            } else if (u < n_r + n_s) {
+                const int t = u - n_r;
+                const float v = mmvf_row(A.sgate, P.xn + t*D, lane);
+                if (lane == 0) P.sgl[t] = v;
+            } else {
+                const int v0 = u - n_r - n_s, t = v0 / (2*FF), j = v0 % (2*FF);
+                const char * w = (j < FF ? A.sg : A.su) + (size_t) (j % FF) * row_bytes<GGML_TYPE_Q8_0>(D);
+                const float v = mmvq_row<GGML_TYPE_Q8_0>(w, P.yq + t*(D/QK8_1), D, lane);
+                if (lane == 0) P.shgu[t*2*FF + j] = v;
+            }
+        }
+    }
+    grid_sync(P.bar, target);
+
+    // per block: top-8 + weights per token, shared expert gate sigmoid, shared swiglu quantized to q8_1
+    if (warp < T) {
+        topk_moe_warp(P.logits + warp*NE, sel[warp], selw[warp], A.clamp, lane);
+    }
+    if (threadIdx.x < T) {
+        const float x = __ldcg(P.sgl + threadIdx.x);
+        sig[threadIdx.x] = 1.0f / (1.0f + expf(-x));
+    }
+    for (int u = warp; u < T*(FF/QK8_1); u += NW) {
+        const int t = u / (FF/QK8_1), b = u % (FF/QK8_1), i = b*QK8_1 + lane;
+        const float g = __ldcg(P.shgu + t*2*FF + i), up = __ldcg(P.shgu + t*2*FF + FF + i);
+        quantize_block(silu_x(g) * up, &shact[t][b], lane);
+    }
+    __syncthreads();
+
+    // phase 2: expert gate / up, shared down (q8_0, K = 512)
+    {
+        const int n_e = T*NU*2*FF, n_d = T*D;
+        for (int u = gw; u < n_e + n_d; u += nwg) {
+            if (u < n_e) {
+                const int t = u / (NU*2*FF), e = (u / (2*FF)) % NU, j = u % (2*FF);
+                const char * w = (j < FF ? A.gate : A.up) + ((size_t) sel[t][e]*FF + j % FF) * row_bytes<tg>(D);
+                const float v = mmvq_row<tg>(w, P.yq + t*(D/QK8_1), D, lane);
+                if (lane == 0) P.egu[u] = v;
+            } else {
+                const int t = (u - n_e) / D, r = (u - n_e) % D;
+                const float v = mmvq_row<GGML_TYPE_Q8_0>(A.sd + (size_t) r * row_bytes<GGML_TYPE_Q8_0>(FF), shact[t], FF, lane);
+                if (lane == 0) P.shd[t*D + r] = v;
+            }
+        }
+    }
+    grid_sync(P.bar, target);
+
+    // phase 3: expert swiglu, quantized to q8_1
+    for (int u = gw; u < T*NU*(FF/QK8_1); u += nwg) {
+        const int te = u / (FF/QK8_1), b = u % (FF/QK8_1), i = b*QK8_1 + lane;
+        const float g = __ldcg(P.egu + te*2*FF + i), up = __ldcg(P.egu + te*2*FF + FF + i);
+        quantize_block(silu_x(g) * up, P.eact + te*(FF/QK8_1) + b, lane);
+    }
+    grid_sync(P.bar, target);
+
+    // phase 4: expert down rows, weighted sum (moe_weighted_reduction_f32), shared expert gate, residual adds
+    for (int u = gw; u < T*D; u += nwg) {
+        const int t = u / D, r = u % D;
+        float sum = 0.0f;
+#pragma unroll 1
+        for (int e = 0; e < NU; e++) {
+            const char * w = A.down + ((size_t) sel[t][e]*D + r) * row_bytes<td>(FF);
+            const float v = mmvq_row<td>(w, P.eact + (t*NU + e)*(FF/QK8_1), FF, lane);
+            const float scale = 1.0f;
+            if (P.dbg && lane == 0) P.dbg[(t*(NU+2) + e)*D + r] = v;
+            if (e == 0) {
+                sum = (v * scale) * selw[t][0];
+            } else {
+                sum += (v * scale) * selw[t][e];
+            }
+        }
+        if (lane == 0) {
+            const float shg = __ldcg(P.shd + t*D + r) * sig[t];
+            if (P.dbg) { P.dbg[(t*(NU+2) + NU)*D + r] = sum; P.dbg[(t*(NU+2) + NU + 1)*D + r] = shg; }
+            float result = sum;
+            result = result + shg;
+            result = result + A.x_in[t*D + r];
+            A.x_out[t*D + r] = result;
+        }
+    }
+}
+
+} // namespace
+
+void ggml_cuda_p60_mega_moe_x(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_moe_args & args, int T) {
+    GGML_ASSERT(T >= 1 && T <= TMAX);
+    const size_t n_xn = (size_t) T*D, n_yq = (size_t) T*(D/QK8_1)*sizeof(block_q8_1)/sizeof(float);
+    const size_t n_lg = (size_t) T*NE, n_sg = 8, n_shgu = (size_t) T*2*FF, n_egu = (size_t) T*NU*2*FF;
+    const size_t n_eact = (size_t) T*NU*(FF/QK8_1)*sizeof(block_q8_1)/sizeof(float) + 8, n_shd = (size_t) T*D;
+    ggml_cuda_pool_alloc<float> scratch(ctx.pool(), n_xn + n_yq + n_lg + n_sg + n_shgu + n_egu + n_eact + n_shd + 64);
+    moe_x_params kp = {};
+    kp.a = args;
+    kp.T = T;
+    float * p = scratch.get();
+    kp.xn = p;                    p += n_xn;
+    kp.yq = (block_q8_1 *) p;     p += n_yq;
+    kp.logits = p;                p += n_lg;
+    kp.sgl = p;                   p += n_sg;
+    kp.shgu = p;                  p += n_shgu;
+    kp.egu = p;                   p += n_egu;
+    kp.eact = (block_q8_1 *) p;   p += n_eact;
+    kp.shd = p;
+    static const int dump_il = getenv("GGML_CUDA_P60_MEGAX_DUMP") ? atoi(getenv("GGML_CUDA_P60_MEGAX_DUMP")) : -1;
+    const bool dump = args.il == dump_il || dump_il == 99;
+    ggml_cuda_pool_alloc<float> dbg(ctx.pool(), dump ? (size_t) T*(NU+2)*D : 1);
+    kp.dbg = dump ? dbg.get() : nullptr;
+    if (ctx.p60_mega_bar == nullptr) {
+        CUDA_CHECK(cudaMalloc(&ctx.p60_mega_bar, sizeof(unsigned)));
+        CUDA_CHECK(cudaMemset(ctx.p60_mega_bar, 0, sizeof(unsigned)));
+        ctx.p60_mega_epoch = 0;
+    }
+    kp.bar  = ctx.p60_mega_bar;
+    kp.base = ctx.p60_mega_epoch;
+    const int nblk = ggml_cuda_info().devices[ctx.device].nsm;
+    void * kargs[] = { &kp };
+    void (*kernel)(const moe_x_params) = nullptr;
+    const bool g5 = args.gate_type == GGML_TYPE_Q5_K, d6 = args.down_type == GGML_TYPE_Q6_K;
+    if      (!g5 && !d6) kernel = p60_mega_moe_x_kernel<GGML_TYPE_Q4_K, GGML_TYPE_Q5_K>;
+    else if (!g5 &&  d6) kernel = p60_mega_moe_x_kernel<GGML_TYPE_Q4_K, GGML_TYPE_Q6_K>;
+    else if ( g5 &&  d6) kernel = p60_mega_moe_x_kernel<GGML_TYPE_Q5_K, GGML_TYPE_Q6_K>;
+    else                 kernel = p60_mega_moe_x_kernel<GGML_TYPE_Q5_K, GGML_TYPE_Q5_K>;
+    CUDA_CHECK(cudaLaunchCooperativeKernel((const void *) kernel, dim3(nblk), dim3(NT), kargs, 0, ctx.stream()));
+    ctx.p60_mega_epoch += (unsigned) (4 * nblk);
+    // GGML_CUDA_P60_MEGAX_DUMP=layer: write token 0's intermediates of that layer as float arrays (debug)
+    if (dump) {
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        std::vector<float> h(D);
+        char fn[64]; snprintf(fn, sizeof(fn), "megax_dump_%d.bin", args.il);
+        FILE * f = fopen(fn, "wb");
+        auto put = [&](const char * name, const float * src, int n) {
+            h.resize(n);
+            CUDA_CHECK(cudaMemcpy(h.data(), src, n*sizeof(float), cudaMemcpyDeviceToHost));
+            fprintf(f, "%s\t%d\n", name, n);
+            fwrite(h.data(), sizeof(float), n, f);
+        };
+        put("attn_post_norm", kp.xn, D);
+        put("ffn_moe_logits", kp.logits, NE);
+        put("shared_expert_gate", kp.sgl, 1);
+        put("ffn_gate", kp.shgu, FF);
+        put("ffn_up", kp.shgu + FF, FF);
+        put("ffn_shexp", kp.shd, D);
+        std::vector<float> g(NU*FF), u(NU*FF), eg(NU*2*FF);
+        CUDA_CHECK(cudaMemcpy(eg.data(), kp.egu, eg.size()*sizeof(float), cudaMemcpyDeviceToHost));
+        for (int e = 0; e < NU; e++) for (int j = 0; j < FF; j++) { g[e*FF + j] = eg[e*2*FF + j]; u[e*FF + j] = eg[e*2*FF + FF + j]; }
+        fprintf(f, "ffn_moe_gate\t%d\n", NU*FF); fwrite(g.data(), sizeof(float), NU*FF, f);
+        fprintf(f, "ffn_moe_up\t%d\n", NU*FF);   fwrite(u.data(), sizeof(float), NU*FF, f);
+        put("ffn_moe_down", kp.dbg, NU*D);
+        put("ffn_moe_out", kp.dbg + NU*D, D);
+        put("ffn_shexp_gated", kp.dbg + (NU+1)*D, D);
+        put("l_out", args.x_out, D);
+        fclose(f);
+    }
+}
