 };
 
-template <ggml_type tg, ggml_type td>
+// Stream of weight rows through a per-warp smem stage: row m + 1 is loaded into registers while row m is computed from
+// smem by the stock vec_dot functions. LD is the load unit (int4 needs 16-byte aligned rows).
+template <typename LD, int NBYTES, typename SrcFn, typename CompFn>
+__device__ __forceinline__ void stream_rows(const int M, uint8_t * stage, const int lane, SrcFn src, CompFn comp) {
+    static_assert(NBYTES % sizeof(LD) == 0, "row size");
+    constexpr int NL = NBYTES / sizeof(LD), PER = (NL + WARP_SIZE - 1) / WARP_SIZE;
+    LD buf[PER];
+    auto ld = [&](int m) {
+        const LD * p = (const LD *) src(m);
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int idx = i*WARP_SIZE + lane;
+            if (idx < NL) buf[i] = __ldg(p + idx);
+        }
+    };
+    if (M > 0) ld(0);
+    for (int m = 0; m < M; m++) {
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int idx = i*WARP_SIZE + lane;
+            if (idx < NL) ((LD *) stage)[idx] = buf[i];
+        }
+        __syncwarp();
+        if (m + 1 < M) ld(m + 1);
+        comp(m, stage);
+        __syncwarp();
+    }
+}
