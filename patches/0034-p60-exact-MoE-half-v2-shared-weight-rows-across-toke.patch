From 7c868752869e12db8eab51014c48e11f89f4413a Mon Sep 17 00:00:00 2001
From: Mrinohk <5554998+Mrinohk@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:03:38 -0400
Subject: [PATCH 34/35] p60 exact: MoE half v2 - shared weight rows across
 tokens, lean exact dots

Same results as v1 (bit-identical to stock decode, T=1..6), reworked:
the kernel is templated on the token count, each weight row (and each
distinct expert of all tokens) is computed once for every token that
uses it, and the stock vec_dot float expressions are fed by cheaper but
equal integer parts: per-token tables of the q8_1 scales and value sums
(dot2), int -> float without I2F, exact float products instead of
32-bit integer multiplies. GGML_CUDA_P60_MEGAX_TIME=1 prints per-phase
times.

Measured: T=1 ~113 us per MoE half (v1 120, stock kernels ~135),
T=6 ~496 us (v1 518). The kernel is instruction bound on the emulated
int8 dot (sm_60 has no dp4a) plus k-quant unpacking, not memory bound.

Assisted-by: Claude Opus 5.5
---
 ggml/src/ggml-cuda/p60-mega-x.cu | 528 +++++++++++++++++++++++++++----
 1 file changed, 471 insertions(+), 57 deletions(-)

diff --git a/ggml/src/ggml-cuda/p60-mega-x.cu b/ggml/src/ggml-cuda/p60-mega-x.cu
index 7919dad6b..026423aba 100644
--- a/ggml/src/ggml-cuda/p60-mega-x.cu
+++ b/ggml/src/ggml-cuda/p60-mega-x.cu
@@ -3,6 +3,7 @@
 #include "unary.cuh"
 
 #include <cstdio>
+#include <type_traits>
 
 // Exact persistent kernels (GGML_CUDA_P60_MEGAX=1, generation steps tagged by GGML_CUDA_P60_EXACT): every token gives
 // bit-identical results to the stock single-token kernels. Each warp emulates the thread layout and reduction order of
@@ -14,6 +15,13 @@ namespace {
 constexpr int NT = 512, NW = NT / 32;
 constexpr int D = 2048, NE = 256, NU = 8, FF = 512, TMAX = 6;
 
+__device__ __forceinline__ unsigned long long gtimer() {
+    unsigned long long t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    return t;
+}
+#define P60X_TM(i) if (P.tm && blockIdx.x == 0 && threadIdx.x == 0) P.tm[i] = gtimer()
+
 __device__ __forceinline__ void grid_sync(unsigned * bar, unsigned & target) {
     __syncthreads();
     if (threadIdx.x == 0) {
@@ -66,6 +74,232 @@ __device__ __forceinline__ float mmvq_row(const void * row, const block_q8_1 * y
     return warp_reduce_sum<WARP_SIZE>(tmp);
 }
 
+// ---- lean exact vec_dot: same float expressions as vecdotq.cuh, but the integer parts are computed more cheaply (an
+// int is the same value however it is computed): int -> float without I2F (quarter rate on sm_60), the q8_1 scales and
+// the sums of the q8_1 values (dot2 of the k-quants) come from per-token tables, and the weight-side unpacking of a
+// row is done once for all tokens.
+
+// exact for |x| < 2^22
+__device__ __forceinline__ float i2f_exact(const int x) {
+    return __int_as_float(0x4B400000 + x) - 12582912.0f;
+}
+
+// per-token tables for a q8_1 vector of nb blocks: d (as float) and the sums of ints q and q + 4 of each block (dot2)
+struct ytab {
+    const block_q8_1 * y;
+    const float * d8;   // [nb]
+    const float * s2;   // [nb][4] (integers, exact)
+};
+
+__device__ __forceinline__ void make_ytab(const block_q8_1 * y, float * d8, float * s2, const int nb, const int i0, const int step) {
+    for (int b = i0; b < nb; b += step) {
+        d8[b] = __low2float(y[b].ds);
+        const int * q = (const int *) y[b].qs;
+#pragma unroll
+        for (int k = 0; k < 4; k++) {
+            s2[4*b + k] = i2f_exact(ggml_cuda_dp4a(0x01010101, q[k + 4], ggml_cuda_dp4a(0x01010101, q[k], 0)));
+        }
+    }
+}
+
+template <ggml_type type> struct lean;
+
+template <> struct lean<GGML_TYPE_Q8_0> {
+    static constexpr int qk = QK8_0, qi = QI8_0, vdr = VDR_Q8_0_Q8_1_MMVQ;
+    struct W { int v[VDR_Q8_0_Q8_1_MMVQ]; float d; };
+    static __device__ __forceinline__ W load(const void * vbq, const int kbx, const int iqs) {
+        const block_q8_0 * bq8_0 = (const block_q8_0 *) vbq + kbx;
+        W w;
+#pragma unroll
+        for (int i = 0; i < vdr; ++i) w.v[i] = get_int_b2(bq8_0->qs, iqs + i);
+        w.d = bq8_0->d;
+        return w;
+    }
+    // b = q8_1 block index of kbx
+    static __device__ __forceinline__ float dot(const W & w, const ytab & Y, const int b, const int iqs) {
+        const block_q8_1 * bq8_1 = Y.y + b;
+        int sumi = 0;
+#pragma unroll
+        for (int i = 0; i < vdr; ++i) sumi = ggml_cuda_dp4a(w.v[i], get_int_b4(bq8_1->qs, iqs + i), sumi);
+        const float d8_0 = w.d, d8_1 = Y.d8[b];
+        return d8_0*d8_1 * i2f_exact(sumi);
+    }
+};
+
+template <> struct lean<GGML_TYPE_Q4_K> {
+    static constexpr int qk = QK_K, qi = QI4_K, vdr = VDR_Q4_K_Q8_1_MMVQ;
+    struct W { int v[2]; float sc[2], m[2]; float2 dm; };
+    static __device__ __forceinline__ W load(const void * vbq, const int kbx, const int iqs) {
+        const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+        const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+        const int * q4 = (const int *)(bq4_K->qs + 16 * bq8_offset + 4 * ((iqs/2)%4));
+        W w;
+        w.v[0] = q4[0];
+        w.v[1] = q4[4];
+        const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+        const int j  = bq8_offset/2;
+        const int jm = j & 1;
+        const uint32_t s0 = scales[jm + 0];
+        const uint32_t s2 = scales[jm + 2];
+        const uint32_t s4 = scales[jm + 4];
+        const uint32_t hi = (uint32_t) -(int32_t) (j >= 2);
+        uint16_t aux[2];
+        aux[0] = (uint16_t) (((s0 & 0x3f3f) & ~hi) | ((((s4 >> 0) & 0x0f0f) | ((s0 & 0xc0c0) >> 2)) & hi));
+        aux[1] = (uint16_t) (((s2 & 0x3f3f) & ~hi) | ((((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2)) & hi));
+        const uint8_t * sc = (const uint8_t *)aux;
+        w.sc[0] = i2f_exact(sc[0]); w.sc[1] = i2f_exact(sc[1]); w.m[0] = i2f_exact(sc[2]); w.m[1] = i2f_exact(sc[3]);
+        w.dm = __half22float2(bq4_K->dm);
+        return w;
+    }
+    static __device__ __forceinline__ float dot(const W & w, const ytab & Y, const int b0, const int iqs) {
+        const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+        float sumf_d = 0.0f;
+        float sumf_m = 0.0f;
+#pragma unroll
+        for (int i = 0; i < QR4_K; ++i) {
+            const int b = b0 + bq8_offset + i;
+            const int * q8 = (const int *)Y.y[b].qs + ((iqs/2)%4);
+            const int v0i = (w.v[0] >> (4*i)) & 0x0F0F0F0F;
+            const int v1i = (w.v[1] >> (4*i)) & 0x0F0F0F0F;
+            const int dot1 = ggml_cuda_dp4a(v1i, q8[4], ggml_cuda_dp4a(v0i, q8[0], 0));
+            const float dot2 = Y.s2[4*b + (iqs/2)%4];
+            const float d8 = Y.d8[b];
+            const float p1 = i2f_exact(dot1) * w.sc[i];   // == (float) (dot1 * sc[i]), exact
+            const float p2 = dot2 * w.m[i];                // == (float) (dot2 * m[i]), exact
+            sumf_d += d8 * p1;
+            sumf_m += d8 * p2;
+        }
+        return w.dm.x*sumf_d - w.dm.y*sumf_m;
+    }
+};
+
+template <> struct lean<GGML_TYPE_Q5_K> {
+    static constexpr int qk = QK_K, qi = QI5_K, vdr = VDR_Q5_K_Q8_1_MMVQ;
+    struct W { int vl[2], vh[2]; float sc[2], m[2]; float2 dm; };
+    static __device__ __forceinline__ W load(const void * vbq, const int kbx, const int iqs) {
+        const block_q5_K * bq5_K = (const block_q5_K *) vbq + kbx;
+        const int bq8_offset = QR5_K * ((iqs/2) / (QI8_1/2));
+        const int * ql = (const int *)(bq5_K->qs + 16 * bq8_offset + 4 * ((iqs/2)%4));
+        const int * qh = (const int *)(bq5_K->qh + 4 * ((iqs/2)%4));
+        W w;
+        w.vl[0] = ql[0];
+        w.vl[1] = ql[4];
+        w.vh[0] = qh[0] >> bq8_offset;
+        w.vh[1] = qh[4] >> bq8_offset;
+        const uint16_t * scales = (const uint16_t *)bq5_K->scales;
+        const int j  = bq8_offset/2;
+        const int jm = j & 1;
+        const uint32_t s0 = scales[jm + 0];
+        const uint32_t s2 = scales[jm + 2];
+        const uint32_t s4 = scales[jm + 4];
+        const uint32_t hi = (uint32_t) -(int32_t) (j >= 2);
+        uint16_t aux[2];
+        aux[0] = (uint16_t) (((s0 & 0x3f3f) & ~hi) | ((((s4 >> 0) & 0x0f0f) | ((s0 & 0xc0c0) >> 2)) & hi));
+        aux[1] = (uint16_t) (((s2 & 0x3f3f) & ~hi) | ((((s4 >> 4) & 0x0f0f) | ((s2 & 0xc0c0) >> 2)) & hi));
+        const uint8_t * sc = (const uint8_t *)aux;
+        w.sc[0] = i2f_exact(sc[0]); w.sc[1] = i2f_exact(sc[1]); w.m[0] = i2f_exact(sc[2]); w.m[1] = i2f_exact(sc[3]);
+        w.dm = __half22float2(bq5_K->dm);
+        return w;
+    }
+    static __device__ __forceinline__ float dot(const W & w, const ytab & Y, const int b0, const int iqs) {
+        const int bq8_offset = QR5_K * ((iqs/2) / (QI8_1/2));
+        float sumf_d = 0.0f;
+        float sumf_m = 0.0f;
+#pragma unroll
+        for (int i = 0; i < QR5_K; ++i) {
+            const int b = b0 + bq8_offset + i;
+            const int * q8 = (const int *)Y.y[b].qs + ((iqs/2)%4);
+            const int vl0i = (w.vl[0] >> (4*i)) & 0x0F0F0F0F;
+            const int vl1i = (w.vl[1] >> (4*i)) & 0x0F0F0F0F;
+            const int vh0i = ((w.vh[0] >> i) << 4) & 0x10101010;
+            const int vh1i = ((w.vh[1] >> i) << 4) & 0x10101010;
+            const int v0i = vl0i | vh0i;
+            const int v1i = vl1i | vh1i;
+            const int dot1 = ggml_cuda_dp4a(v0i, q8[0], ggml_cuda_dp4a(v1i, q8[4], 0));
+            const float dot2 = Y.s2[4*b + (iqs/2)%4];
+            const float d8 = Y.d8[b];
+            const float p1 = i2f_exact(dot1) * w.sc[i];   // == (float) (dot1 * sc[i]), exact
+            const float p2 = dot2 * w.m[i];                // == (float) (dot2 * m[i]), exact
+            sumf_d += d8 * p1;
+            sumf_m += d8 * p2;
+        }
+        return w.dm.x*sumf_d - w.dm.y*sumf_m;
+    }
+};
+
+template <> struct lean<GGML_TYPE_Q6_K> {
+    static constexpr int qk = QK_K, qi = QI6_K, vdr = VDR_Q6_K_Q8_1_MMVQ;
+    struct W { int vl, vh; float sc[2]; float d; };
+    static __device__ __forceinline__ W load(const void * vbq, const int kbx, const int iqs) {
+        const block_q6_K * bq6_K = (const block_q6_K *) vbq + kbx;
+        const int scale_offset = (QI6_K/4) * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/8);
+        const int vh_shift = 2 * ((iqs % (QI6_K/2)) / (QI6_K/4));
+        W w;
+        w.vl = get_int_b2(bq6_K->ql, iqs);
+        w.vh = get_int_b2(bq6_K->qh, (QI6_K/4) * (iqs / (QI6_K/2)) + iqs % (QI6_K/4)) >> vh_shift;
+        const int8_t * scales = bq6_K->scales + scale_offset;
+        w.sc[0] = i2f_exact(scales[0]); w.sc[1] = i2f_exact(scales[4]);
+        w.d = bq6_K->d;
+        return w;
+    }
+    static __device__ __forceinline__ float dot(const W & w, const ytab & Y, const int b0, const int iqs) {
+        const int bq8_offset = 2 * QR6_K * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/4);
+        float sumf = 0.0f;
+#pragma unroll
+        for (int i = 0; i < QR6_K; ++i) {
+            const int b = b0 + bq8_offset + 2*i;
+
+            const int vil = (w.vl >> (4*i)) & 0x0F0F0F0F;
+            const int vih = ((w.vh >> (4*i)) << 4) & 0x30303030;
+            const int vi = __vsubss4((vil | vih), 0x20202020);
+            const float d8 = Y.d8[b];
+            const float p = i2f_exact(ggml_cuda_dp4a(vi, get_int_b4(Y.y[b].qs, iqs % QI8_1), 0)) * w.sc[i];
+            sumf += d8 * p;
+        }
+        return w.d*sumf;
+    }
+};
+
+// mul_mat_vec_q rows (ncols_dst = 1, 4 warps) for up to TMAX tokens (bit t of mask): the weight unpacking is shared
+template <ggml_type type, int TT>
+__device__ __forceinline__ void mmvq_row_t(const void * row, const int ncols_x, const ytab * Y, const unsigned mask,
+        const int lane, float * out) {
+    using L = lean<type>;
+    constexpr int nwarps = 4;
+    const int blocks_per_row_x = ncols_x / L::qk;
+    constexpr int blocks_per_iter = L::vdr * nwarps*WARP_SIZE / L::qi;
+    float part[TT][nwarps];
+#pragma unroll
+    for (int t = 0; t < TT; t++)
+#pragma unroll
+        for (int w = 0; w < nwarps; w++) part[t][w] = 0.0f;
+#pragma unroll
+    for (int w = 0; w < nwarps; w++) {
+        const int tid = WARP_SIZE*w + lane;
+        for (int kbx = tid / (L::qi/L::vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (L::qk/QK8_1);
+            const int kqs = L::vdr * (tid % (L::qi/L::vdr));
+            const typename L::W wd = L::load(row, kbx, kqs);
+#pragma unroll
+            for (int t = 0; t < TT; t++) {
+                if (mask & (1u << t)) part[t][w] += L::dot(wd, Y[t], kby, kqs);
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < TT; t++) {
+        if (mask & (1u << t)) {
+            float tmp = part[t][0];
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp += part[t][l + 1];
+            }
+            tmp = warp_reduce_sum<WARP_SIZE>(tmp);
+            out[t] = tmp;
+        }
+    }
+}
