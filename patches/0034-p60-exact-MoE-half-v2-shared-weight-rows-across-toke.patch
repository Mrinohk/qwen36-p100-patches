+// mul_mat_vec_f rows (block_size 256, K = 2048) for T tokens: the weight row is read once
+template <int TT>
+__device__ __forceinline__ void mmvf_row_t(const float * x, const float * y, const int lane, float * out) {
+    constexpr int block_size = 256, ncols2 = D / 2, NWV = block_size / WARP_SIZE;
+    const float2 * x2 = (const float2 *) x;
+    const float2 * y2 = (const float2 *) y;
+    float sumf[TT][NWV];
+#pragma unroll
+    for (int t = 0; t < TT; t++)
+#pragma unroll
+        for (int w = 0; w < NWV; w++) sumf[t][w] = 0.0f;
+#pragma unroll
+    for (int w = 0; w < NWV; w++) {
+        const int tid = WARP_SIZE*w + lane;
+#pragma unroll
+        for (int col2 = tid; col2 < ncols2; col2 += block_size) {
+            const float2 tmpx = __ldg(x2 + col2);
+#pragma unroll
+            for (int t = 0; t < TT; t++) {
+                {
+                    const float2 tmpy = __ldcg(y2 + t*ncols2 + col2);
+                    ggml_cuda_mad(sumf[t][w], tmpx.x, tmpy.x);
+                    ggml_cuda_mad(sumf[t][w], tmpx.y, tmpy.y);
+                }
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < TT; t++) {
+        {
+            float v = 0.0f;
+#pragma unroll
+            for (int w = 0; w < NWV; w++) {
+                const float r = warp_reduce_sum<WARP_SIZE>(sumf[t][w]);
+                if (lane == w) v = r;
+            }
+            v = warp_reduce_sum<WARP_SIZE>(v);
+            if (lane == 0) out[t] = v;
+        }
+    }
+}
+
+constexpr int Q8C = 32*34;                  // a 1024-wide q8_0 chunk (half of a 2048 row)
+constexpr int YQ_BYTES  = TMAX*(D/QK8_1)*sizeof(block_q8_1);
+constexpr int YT_BYTES  = TMAX*(D/QK8_1)*(sizeof(float) + 4*sizeof(float));       // d8 + s2 tables of yq
+constexpr int ET_BYTES  = TMAX*NU*(FF/QK8_1)*(sizeof(float) + 4*sizeof(float));  // d8 + s2 tables of eact
+template <ggml_type tg> constexpr __host__ __device__ int ubuf_bytes() {
+    constexpr int u1 = YQ_BYTES + YT_BYTES;
+    constexpr int u4 = ET_BYTES + NW*TMAX*NU*(int) sizeof(float);
+    return u1 > u4 ? u1 : u4;
+}
