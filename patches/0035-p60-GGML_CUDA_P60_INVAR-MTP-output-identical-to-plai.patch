diff --git a/ggml/src/ggml-cuda/p60-mega-t.cu b/ggml/src/ggml-cuda/p60-mega-t.cu
index 5e67adc7d..cc8304eed 100644
--- a/ggml/src/ggml-cuda/p60-mega-t.cu
+++ b/ggml/src/ggml-cuda/p60-mega-t.cu
@@ -1,6 +1,8 @@
 #include "p60-mega.cuh"
 #include "p60-mt.cuh"
 
+#include <cstdio>
+
 // Persistent multi-token (T = 2..6, MTP verify) kernels for the Qwen3.5/3.6 MoE layer halves on sm_60, plus the gated
 // delta net half with recurrent-state snapshots (n_rs_seq > 0, also at T = 1). See p60-mega.cuh.
 // Activations are fp16 in shared memory, groups of 4 stored as [x0, x2, x1, x3] so that a 32-bit weight word turns
@@ -862,6 +864,15 @@ void ggml_cuda_p60_mega_moe_t(ggml_backend_cuda_context & ctx, const ggml_cuda_p
     const bool gu5 = args.gate_type == GGML_TYPE_Q5_K, dn6 = args.down_type == GGML_TYPE_Q6_K;
     GGML_ASSERT((args.gate_type == GGML_TYPE_Q4_K || gu5) && (args.down_type == GGML_TYPE_Q5_K || dn6) && (!gu5 || dn6));
     mega_launch(ctx, kern[gu5 ? 2 : dn6 ? 1 : 0][n_tokens - 1], kp, 3);
+    // GGML_CUDA_P60_MEGAT_DUMP=layer (99 = all): token 0's l_out of that layer (debug), file per token count
+    static const int dump_il = getenv("GGML_CUDA_P60_MEGAT_DUMP") ? atoi(getenv("GGML_CUDA_P60_MEGAT_DUMP")) : -1;
+    if (args.il == dump_il || dump_il == 99) {
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        std::vector<float> h(D);
+        CUDA_CHECK(cudaMemcpy(h.data(), args.x_out, D*sizeof(float), cudaMemcpyDeviceToHost));
+        char fn[64]; snprintf(fn, sizeof(fn), "megat_moe_%d_T%d.bin", args.il, n_tokens);
+        FILE * f = fopen(fn, "wb"); fwrite(h.data(), sizeof(float), D, f); fclose(f);
+    }
 }
 
 void ggml_cuda_p60_mega_gdn_t(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_gdn_args & args, int n_tokens, int n_snap,
@@ -892,6 +903,23 @@ void ggml_cuda_p60_mega_gdn_t(ggml_backend_cuda_context & ctx, const ggml_cuda_p
     static const void * const kern[TM] = { (const void *) gdn_t_kernel<1>, (const void *) gdn_t_kernel<2>, (const void *) gdn_t_kernel<3>,
                                            (const void *) gdn_t_kernel<4>, (const void *) gdn_t_kernel<5>, (const void *) gdn_t_kernel<6> };
     mega_launch(ctx, kern[n_tokens - 1], kp, 3);
+    // GGML_CUDA_P60_MEGAT_DUMP=layer: token 0's intermediates of that layer (debug), file per token count
+    static const int dump_il = getenv("GGML_CUDA_P60_MEGAT_DUMP") ? atoi(getenv("GGML_CUDA_P60_MEGAT_DUMP")) : -1;
+    if (args.il == dump_il) {
+        CUDA_CHECK(cudaStreamSynchronize(ctx.stream()));
+        char fn[64]; snprintf(fn, sizeof(fn), "megat_gdn_%d_T%d.bin", args.il, n_tokens);
+        FILE * f = fopen(fn, "wb");
+        std::vector<float> h;
+        auto put = [&](const char * name, const float * src, int n) {
+            h.resize(n);
+            CUDA_CHECK(cudaMemcpy(h.data(), src, n*sizeof(float), cudaMemcpyDeviceToHost));
+            fprintf(f, "%s\t%d\n", name, n);
+            fwrite(h.data(), sizeof(float), n, f);
+        };
+        put("qkvc", kp.qkvc, QKV); put("zv", kp.zv, VD); put("gb", kp.gb, 2 * HV); put("o", kp.o, VD);
+        put("y0", kp.y, D); put("y1", kp.y + (size_t) TM * D, D); put("x_out", args.x_out, D);
+        fclose(f);
+    }
 }
 
