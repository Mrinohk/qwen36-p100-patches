diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index 1adfeaf4f..5114d705e 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -305,6 +305,13 @@ static const char * cu_get_error_str(CUresult err) {
 #define FLASH_ATTN_AVAILABLE
 #endif // !defined(GGML_CUDA_NO_FA) && !(defined(GGML_USE_MUSA) && __MUSA_ARCH__ < 220)
 
+// GGML_CUDA_P60_INVAR=1: single-token decode runs the multi-token (MTP verify) persistent kernels with T = 1, so a token
+// gets bit-identical results whether it is decoded alone or verified in a batch of up to 6
+static inline bool ggml_cuda_p60_invar() {
+    static const bool on = getenv("GGML_CUDA_P60_INVAR") != nullptr && atoi(getenv("GGML_CUDA_P60_INVAR")) != 0;
+    return on;
+}
+
 // op_params[15] of MUL_MAT / MUL_MAT_ID set by llama under GGML_CUDA_P60_EXACT for generation steps (decode, MTP verify)
 #define GGML_CUDA_P60_EXACT_TAG 0x50363045
 
